[
  {
    "name": "theme_info",
    "theme_name": "FYE v3",
    "theme_version": "3.0.0",
    "theme_author": "For Your Eternity",
    "theme_documentation_url": "https:\/\/foryoureternity.com",
    "theme_support_url": "https:\/\/foryoureternity.com\/pages\/contact"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "paragraph",
        "content": "Colour, type and spacing are defined in assets\/fye-core.css, not here. That is deliberate — one source of truth. See docs\/architecture.md."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo"
      },
      {
        "type": "range",
        "id": "logo_width",
        "label": "Logo width",
        "min": 100,
        "max": 320,
        "step": 5,
        "unit": "px",
        "default": 175
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Navigation",
    "settings": [
      {
        "type": "link_list",
        "id": "menu_main",
        "label": "Main menu",
        "default": "main-menu"
      },
      {
        "type": "link_list",
        "id": "menu_footer",
        "label": "Footer menu",
        "default": "footer"
      }
    ]
  },
  {
    "name": "Announcement bar",
    "settings": [
      {
        "type": "checkbox",
        "id": "announcement_show",
        "label": "Show announcement bar",
        "default": true
      },
      {
        "type": "text",
        "id": "announcement_text",
        "label": "Text",
        "default": "Beautiful Jewellery. Ethically Made. Fairly Priced."
      },
      {
        "type": "url",
        "id": "announcement_link",
        "label": "Link"
      }
    ]
  },
  {
    "name": "Contact",
    "settings": [
      {
        "type": "text",
        "id": "phone",
        "label": "Phone"
      },
      {
        "type": "text",
        "id": "email",
        "label": "Email",
        "default": "hello@foryoureternity.com"
      }
    ]
  }
]
