{%- comment -%}
  announcement-bar — pale sage strip above the header.
  Measured from the live site: ground #EEF2EE, 47.5px tall, 16px Outfit Light,
  sentence case (NOT uppercase), centred, teal.
{%- endcomment -%}
{%- if section.settings.text != blank -%}
  <div class="ann">
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <span>{{ section.settings.text }}</span>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
.fye .ann {
  background: var(--sage-pale);
  color: var(--ink);
  padding: var(--s3) var(--pad-x);
  text-align: center;
  font-size: 16px;
  font-weight: var(--fw-light);
  line-height: 1.4;
}
.fye .ann a { color: inherit; text-decoration: underline; text-underline-offset: 3px; }
.fye .ann a:hover { color: var(--sage); }
@media (max-width: 560px) { .fye .ann { font-size: 14px; padding: var(--s2) var(--pad-x); } }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Ethically sourced, independently certified, fairly priced. Book a free consultation — in London or online." },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
