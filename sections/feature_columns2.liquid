{%- comment -%}
  feature_columns2 — a row of text/image columns of unequal width. 7 uses:
  index, article, blog, page.contact, page.create, collection.engagment,
  collection.wedding.

  Each block is a column and sets its own width out of 12, which is the one
  genuinely useful thing the old version did: the homepage runs a 3-wide logo
  beside an 8-wide heading-and-paragraph, and that asymmetry is the layout.
  So `col_dk` survives as a 12-column span. Everything else went.

  SETTINGS DROPPED, with reasons:
    design_heading, heading_align, icon_heading, tophead_mb
      — headings are the flanked centred device sitewide; `icon_heading` was a
        Line Awesome gem and there is no icon font in v3.
    fs_title, fs_text, fs_title_mb, fs_text_mb
      — four font sizes per section, set independently on 7 templates. This is
        the single clearest example of what the rebuild is for: the homepage had
        35px/25px titles against the design system's scale.
    image_ratio, image_size, image_position, img_effect, b_effect
    space_h_item, space_v_item, space_h_item_mb, space_v_item_mb  — --grid-gap
    button_style, btn_size, btn_cl, button_effect  — two button styles exist
    pos_text, text_align  — kept as one section-level `text_align`
    col_tb, col_mb  — columns stack below 900; a tablet-specific count on top
      of that produced layouts nobody had looked at
    layout, custom_css

  KEPT, with their IDs: `top_heading`, `text_align`; per block `enable_image`,
  `image`, `title`, `text`, `button_label`, `button_link`, `open_link`,
  `col_dk`.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'white'
  assign align = s.text_align | default: 'left'

  comment
    Column titles are h3 under the band's own h2. When the band has NO
    heading (the homepage "Why choose For Your Eternity?" strip) an h3
    would follow the page's h1 directly and skip a level, which is exactly
    what fyeSmoke reported on 03/09/2026 once the chrome headings were
    taken out of the outline. So the titles step up to h2 in that case;
    .fcols__title pins the size to --fs-h3 either way, so nothing looks
    different.
  endcomment
  assign title_tag = 'h3'
  if s.top_heading == blank
    assign title_tag = 'h2'
  endif
-%}

<section class="fcols band band--{{ band }} fcols--{{ align }}{% if s.pad == 'tight' %} fcols--tight{% endif %}" data-screen-label="Feature columns">
  <div class="wrap">
    {%- if s.top_heading != blank -%}
      <div class="sect-head">
        <h2 class="heading-flank">{{ s.top_heading }}</h2>
      </div>
    {%- endif -%}

    <div class="fcols__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign span = b.col_dk | default: 4
          comment
            Files rarely carry an alt, and an empty alt on a content image
            cost the homepage its SEO score (audit 02/09/2026, A3). The
            column's own heading names what the picture is of, so it is the
            fallback, as custom-collections already does.
          endcomment
          assign img_alt = b.image.alt | default: b.title | default: s.top_heading | strip_html
        -%}
        <div class="fcols__col" style="--span: {{ span }};" {{ block.shopify_attributes }}>
          {%- if b.enable_image and b.image != blank -%}
            <div class="fcols__media">
              {{ b.image | image_url: width: 800 | image_tag:
                 loading: 'lazy', widths: '200,400,600,800',
                 sizes: '(max-width: 900px) 100vw, 30vw',
                 alt: img_alt }}
            </div>
          {%- endif -%}

          {%- if b.title != blank -%}
            <{{ title_tag }} class="fcols__title">{{ b.title }}</{{ title_tag }}>
          {%- endif -%}

          {%- if b.text != blank -%}
            <div class="fcols__text">{{ b.text }}</div>
          {%- endif -%}

          {%- if b.button_label != blank and b.button_link != blank -%}
            <a class="btn btn--outline fcols__btn" href="{{ b.button_link }}"
              {%- if b.open_link == '_blank' %} target="_blank" rel="noopener"{% endif -%}>
              {{ b.button_label }}
            </a>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* Twelve columns; each block spans --span of them. The homepage's 3 + 8 leaves
   one column of air between, which is the point. */
.fye .fcols__grid {
  display: grid;
  grid-template-columns: repeat(12, minmax(0, 1fr));
  gap: var(--s7) var(--grid-gap);
  align-items: center;
}
.fye .fcols__col {
  grid-column: span var(--span, 4);
  display: flex;
  flex-direction: column;
  gap: var(--s4);
  align-items: flex-start;
}
.fye .fcols--center .fcols__col { align-items: center; text-align: center; }
.fye .fcols--right .fcols__col { align-items: flex-end; text-align: right; }

/* A logo or mark, not a photograph — contain, and never bigger than it is.
   Without the cap the monogram stretches to the full column, which on the
   homepage is 3 of 12 columns and far larger than the wordmark is drawn for. */
/* 320px is the artwork's drawn size. Live runs the mark at the full width of
   its 3-of-12 column — roughly 300px — and at my old 180px cap it read as an
   afterthought beside lead-scale type. */
.fye .fcols__media { width: 100%; max-width: 320px; }

/* h3 scale whether the title is an h2 or an h3, see the note at the top. */
.fye .fcols__title { font-size: var(--fs-h3); }
.fye .fcols__media :where(img) { display: block; width: 100%; height: auto; }
.fye .fcols--center .fcols__media { margin-inline: auto; }

/* Lead scale, not body scale. Live sets 25px here. This band is one paragraph
   carrying the whole brand argument, not running text — see the note in
   fix-whychoose.mjs on why the dropped fs_text setting had a point. */
.fye .fcols__text {
  color: var(--ink-soft);
  font-size: var(--fs-lead);
  line-height: 1.55;
  text-wrap: pretty;
}
.fye .band--teal .fcols__text,
.fye .band--sage .fcols__text { color: var(--on-dark); }

/* EXCEPTION to the --sect-y rule, deliberate: a band whose entire content is
   one mark and one paragraph is a strip on live (10px of vertical padding).
   At --sect-y it is more than twice as tall as its content needs. Two values
   only, and the default leaves every other use untouched. */
.fye .fcols--tight { padding-block: var(--s6); }
.fye .fcols__btn { margin-top: var(--s2); }

@media (max-width: 900px) {
  .fye .fcols__col { grid-column: 1 / -1; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Feature columns",
  "settings": [
    { "type": "text", "id": "top_heading", "label": "Heading", "info": "Optional — the columns often carry their own." },
    {
      "type": "select", "id": "text_align", "label": "Alignment", "default": "left",
      "options": [
        { "value": "left",   "label": "Left" },
        { "value": "center", "label": "Centred" },
        { "value": "right",  "label": "Right" }
      ]
    },
    {
      "type": "select", "id": "pad", "label": "Vertical space", "default": "standard",
      "info": "Tight suits a band of one mark and one paragraph.",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "tight",    "label": "Tight" }
      ]
    },
    {
      "type": "select", "id": "band", "label": "Background", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "mist",  "label": "Mist" },
        { "value": "teal",  "label": "Teal" }
      ]
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "text_block",
      "name": "Column",
      "settings": [
        {
          "type": "select", "id": "col_dk", "label": "Width", "default": "4",
          "info": "Out of 12. Columns stack below 900px.",
          "options": [
            { "value": "3",  "label": "A quarter (3)" },
            { "value": "4",  "label": "A third (4)" },
            { "value": "6",  "label": "Half (6)" },
            { "value": "8",  "label": "Two thirds (8)" },
            { "value": "9",  "label": "Three quarters (9)" },
            { "value": "12", "label": "Full width (12)" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" },
        { "type": "checkbox", "id": "enable_image", "label": "Show an image", "default": false },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        {
          "type": "select", "id": "open_link", "label": "Open link in", "default": "_self",
          "options": [
            { "value": "_self",  "label": "Same tab" },
            { "value": "_blank", "label": "New tab" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature columns",
      "blocks": [{ "type": "text_block" }, { "type": "text_block" }]
    }
  ]
}
{% endschema %}
