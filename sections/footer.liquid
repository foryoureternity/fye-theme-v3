{%- comment -%}
  footer — rebuilt 27/08/2026 against the LIVE site, measured from a 2x
  screenshot at a 1470px viewport. Every number here was sampled.

    ground              #879C87   (Ed's spec; screenshot sampled #8B9B89)
    type                 teal     — NOT ivory. Sampled #293D46 on the ground.
    measure             1320px    (--maxw), centred
    columns             5 x 232px, 40px gap
    padding-block-start   96px
    hairlines           rgba(35,61,71,0.22) — sampled #75867A over the ground

    heading             20px Tenor, uppercase, +0.08em
    link                17px Outfit Light, ~30px row pitch
    phone               24px / 600
    BOOK CONSULTATION   223x41, white ground, teal type, 15px / 600 / +0.15em
    monogram            94 x 100
    strapline           30px Tenor, wraps after "MADE."
    newsletter          underlined input + 45x44 teal arrow button

  Teal on #879C87 measures 4.8:1 — AA for normal text. Ivory on this ground
  would be 2.6:1, which is why the live site uses teal and this file must not
  be "corrected" to the ivory-on-sage band pattern in fye-core.css. This is
  chrome with its own ground, not a .band--sage content band.

  Link columns are BLOCKS with a link_list so they stay editable.
{%- endcomment -%}

<footer class="ftr">
  <div class="ftr__in">

    <div class="ftr__cols">
      {%- for block in section.blocks -%}
        {%- if block.type == 'links' -%}
          <details class="ftr__col ftr__acc" open {{ block.shopify_attributes }}>
            <summary class="ftr__head">{{ block.settings.heading | default: 'More' }}</summary>
            {%- assign list = linklists[block.settings.menu] -%}
            {%- if list.links.size > 0 -%}
              <ul class="ftr__list">
                {%- for link in list.links -%}
                  <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </details>
        {%- endif -%}
      {%- endfor -%}

      <details class="ftr__col ftr__talk ftr__acc" open>
        <summary class="ftr__head">{{ section.settings.talk_heading | default: 'Talk to us' }}</summary>
        {%- if section.settings.phone != blank -%}
          <a class="ftr__phone" href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
        {%- endif -%}
        {%- if section.settings.hours != blank -%}
          <p class="ftr__hours">{{ section.settings.hours }}</p>
        {%- endif -%}
        <ul class="ftr__list ftr__list--loose">
          {%- if section.settings.email != blank -%}
            <li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>
          {%- endif -%}
          {%- if section.settings.whatsapp_url != blank -%}
            <li><a href="{{ section.settings.whatsapp_url }}">Message us on WhatsApp</a></li>
          {%- endif -%}
        </ul>
        {%- if section.settings.cta_label != blank -%}
          <a class="ftr__cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        <div class="ftr__social">
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" aria-label="Instagram" target="_blank" rel="noopener">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17"></rect><circle cx="12" cy="12" r="4.2"></circle><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"></circle></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.whatsapp_url != blank -%}
            <a href="{{ section.settings.whatsapp_url }}" aria-label="WhatsApp" target="_blank" rel="noopener">
              <svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 12a8.5 8.5 0 0 1-12.7 7.4L3.5 20.5l1.1-4.3A8.5 8.5 0 1 1 20.5 12z"></path><path d="M8.8 8.6c0 3.1 2.5 5.6 5.6 5.6"></path></svg>
            </a>
          {%- endif -%}
        </div>
      </details>
    </div>

    <hr class="ftr__rule">

    <div class="ftr__brand">
      <div class="ftr__mark">
        {%- comment -%}
          Gated on mono_url. It used to be gated on the monogram image_picker,
          which is empty and always will be — a picker cannot render an SVG,
          which is the whole reason this moved to a URL.
        {%- endcomment -%}
        {%- assign mono = section.settings.mono_url | default: 'https://cdn.shopify.com/s/files/1/0972/5391/7056/files/FYE-initial-logo.svg?v=1771578232' -%}
        {%- if mono != blank -%}
          <img class="ftr__mono-img" src="{{ mono }}" alt="{{ shop.name | escape }}" width="100" height="100" loading="lazy">
        {%- endif -%}
      </div>
      <div class="ftr__brand-copy">
        {%- if section.settings.strapline != blank -%}
          <h2 class="ftr__strap">{{ section.settings.strapline }}</h2>
        {%- endif -%}
        {%- if section.settings.mission != blank -%}
          <div class="ftr__mission">{{ section.settings.mission }}</div>
        {%- endif -%}
      </div>
      <div class="ftr__signup">
        {%- if section.settings.signup_heading != blank -%}
          <h3 class="ftr__head ftr__head--sm">{{ section.settings.signup_heading }}</h3>
        {%- endif -%}
        {%- form 'customer', class: 'ftr__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="visually-hidden" for="ftr-email">Email address</label>
          <input id="ftr-email" type="email" name="contact[email]" placeholder="Your email address" required>
          <button type="submit" aria-label="Subscribe">{% render 'icon', name: 'arrow-right', size: 20 %}</button>
        {%- endform -%}
        {%- if section.settings.signup_note != blank -%}
          <p class="ftr__note">{{ section.settings.signup_note }}</p>
        {%- endif -%}
      </div>
    </div>

    <hr class="ftr__rule">

    <div class="ftr__legal">
      {%- if section.settings.legal != blank -%}
        <div class="ftr__legal-text">{{ section.settings.legal }}</div>
      {%- endif -%}
      {%- assign policies = linklists[section.settings.policy_menu] -%}
      {%- if policies.links.size > 0 -%}
        <ul class="ftr__policies">
          {%- for link in policies.links -%}
            <li><a href="{{ link.url }}">{{ link.title }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

  </div>

  <button class="ftr__top" type="button" aria-label="Back to top" data-fye-top>
    {% render 'icon', name: 'chevron-up', size: 20 %}
  </button>
</footer>

{% stylesheet %}
/* Chrome with its own ground. Teal type — see the note in this file's header
   comment before changing either colour. */
.fye .ftr {
  position: relative;
  background: #879C87;
  color: var(--ink);
  padding: 96px var(--s7) var(--s9);
}
.fye .ftr__in { max-width: var(--maxw); margin-inline: auto; }
.fye .ftr :where(a) { color: var(--ink); }
.fye .ftr :where(a:hover) { color: var(--white); }

.fye .ftr__head {
  margin: 0 0 var(--s7);
  font-family: var(--font-display);
  font-size: 20px;
  font-weight: var(--fw-regular);
  letter-spacing: var(--tr-h2);
  line-height: 1.3;
  text-transform: uppercase;
  color: var(--ink);
}
.fye .ftr__head--sm { font-family: var(--font-body); font-size: 13px; font-weight: var(--fw-medium); letter-spacing: var(--tr-eyebrow); margin-bottom: var(--s5); }

.fye .ftr__cols {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--s8);
  padding-bottom: var(--s11);
}
.fye .ftr__list { margin: 0; padding: 0; list-style: none; }
.fye .ftr__list li { margin-bottom: 4px; }
.fye .ftr__list a { font-size: 17px; font-weight: var(--fw-light); line-height: 1.55; }
.fye .ftr__list--loose li { margin-bottom: var(--s4); }

.fye .ftr__phone {
  display: block;
  font-size: 24px;
  font-weight: var(--fw-semi);
  line-height: 1.2;
  letter-spacing: 0.01em;
}
.fye .ftr__hours {
  margin: var(--s1) 0 var(--s6);
  font-size: 16px;
  font-weight: var(--fw-light);
  color: rgba(35, 61, 71, 0.78);
}

.fye .ftr__cta {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 41px;
  margin-top: var(--s5);
  padding: 0 var(--s6);
  background: var(--white);
  color: var(--ink);
  font-size: 15px;
  font-weight: var(--fw-semi);
  letter-spacing: 0.15em;
  line-height: 1;
  text-transform: uppercase;
  transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
}
.fye .ftr__cta:hover { background: var(--teal); color: var(--ivory); }

.fye .ftr__social { display: flex; gap: var(--s7); margin-top: var(--s8); }
.fye .ftr__social .icon { width: 20px; height: 20px; }

.fye .ftr__rule { border: 0; border-top: 1px solid rgba(35, 61, 71, 0.22); margin: 0; }

.fye .ftr__brand {
  display: grid;
  grid-template-columns: 110px minmax(0, 1fr) 400px;
  gap: 50px;
  align-items: start;
  padding-block: var(--s10);
}
.fye .ftr__mark img { width: 94px; height: auto; }
.fye .ftr__strap {
  margin: 0 0 var(--s5);
  font-family: var(--font-display);
  font-size: 30px;
  font-weight: var(--fw-regular);
  letter-spacing: var(--tr-h2);
  line-height: 1.3;
  text-transform: uppercase;
  max-width: 18em;
}
.fye .ftr__mission { font-size: 17px; font-weight: var(--fw-light); max-width: 60ch; }

.fye .ftr__form { display: flex; align-items: stretch; border-bottom: 1px solid var(--teal); }
.fye .ftr__form input {
  flex: 1 1 auto;
  min-height: 44px;
  padding: 0;
  border: 0;
  background: none;
  font-size: 17px;
  font-weight: var(--fw-light);
  color: var(--ink);
}
.fye .ftr__form input::placeholder { color: rgba(35, 61, 71, 0.66); }
.fye .ftr__form input:focus { outline: none; border: 0; }
.fye .ftr__form button {
  flex: 0 0 auto;
  width: 45px;
  border: 0;
  background: var(--teal);
  color: var(--ivory);
  display: grid; place-items: center;
  transition: background var(--dur) var(--ease);
}
.fye .ftr__form button:hover { background: var(--white); color: var(--teal); }
.fye .ftr__note { margin: var(--s4) 0 0; font-size: 15px; font-weight: var(--fw-light); }

.fye .ftr__legal {
  display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between;
  gap: var(--s6);
  padding-top: var(--s9);
}
.fye .ftr__legal-text { font-size: 15px; font-weight: var(--fw-light); line-height: 1.6; max-width: 70ch; }
.fye .ftr__policies { display: flex; flex-wrap: wrap; gap: var(--s6); margin: 0; padding: 0; list-style: none; }
.fye .ftr__policies li { margin: 0; }
.fye .ftr__policies a { font-size: 16px; font-weight: var(--fw-light); }

.fye .ftr__top {
  position: fixed; right: 0; bottom: 0; z-index: 30;
  width: 48px; height: 48px;
  border: 0;
  background: var(--white);
  color: var(--ink);
  display: grid; place-items: center;
}
.fye .ftr__top:hover { background: var(--teal); color: var(--ivory); }

@media (max-width: 1280px) {
  .fye .ftr__cols { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s8) var(--s7); }
  .fye .ftr__brand { grid-template-columns: 110px minmax(0, 1fr); gap: var(--s8); }
  .fye .ftr__signup { grid-column: 2; }
}
@media (max-width: 900px) {
  .fye .ftr { padding: var(--s11) var(--pad-x) var(--s7); }
  .fye .ftr__cols { grid-template-columns: repeat(2, minmax(0, 1fr)); padding-bottom: var(--s9); }
  .fye .ftr__brand { grid-template-columns: 1fr; padding-block: var(--s9); }
  .fye .ftr__signup { grid-column: 1; }
  .fye .ftr__strap { font-size: 24px; }
}
@media (max-width: 560px) {
  .fye .ftr__cols { grid-template-columns: 1fr; gap: var(--s7); }
  .fye .ftr__legal { flex-direction: column; }
  .fye .ftr__policies { gap: var(--s4) var(--s6); }
}

/* ============================================================================
   ACCORDION COLUMNS — 28/08/2026
   The columns are <details open>. Desktop shows them as plain columns with an
   inert heading; below 769px they become tappable rows. Script sets the
   default state per breakpoint (see fye-ui.js) — with no script they stay open,
   which is the safe failure.
   ========================================================================== */

/* Kill the default marker everywhere. Both properties are needed. */
.fye .ftr__acc > summary { list-style: none; }
.fye .ftr__acc > summary::-webkit-details-marker { display: none; }

@media (min-width: 769px) {
  /* A heading that is not a control should not behave like one. */
  .fye .ftr__acc > summary { pointer-events: none; cursor: default; }
}

@media (max-width: 768px) {
  .fye .ftr__cols {
    display: block;
    padding-bottom: var(--s7);
  }

  .fye .ftr__acc {
    border-top: 1px solid rgba(35, 61, 71, 0.22);
  }
  .fye .ftr__acc:last-of-type { border-bottom: 1px solid rgba(35, 61, 71, 0.22); }

  .fye .ftr__acc > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    /* 56px is the tap target; the type is the same 20px display face as the
       desktop heading, so nothing about the brand changes on a phone. */
    min-height: 56px;
    margin: 0;
    padding: var(--s3) 0;
    cursor: pointer;
    font-size: 17px;
    letter-spacing: 0.08em;
  }
  .fye .ftr__acc > summary::after {
    content: "+";
    flex: none;
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: var(--fw-light);
    line-height: 1;
    transition: transform var(--dur) var(--ease);
  }
  .fye .ftr__acc[open] > summary::after { content: "\2212"; }

  /* Everything that is not the summary is the panel. */
  .fye .ftr__acc > *:not(summary) { margin-bottom: var(--s5); }
  .fye .ftr__acc > *:first-of-type { margin-top: 0; }
  .fye .ftr__list li { margin-bottom: var(--s2); }
  .fye .ftr__list a { font-size: 16px; }

  /* The talk column's own furniture needs to sit inside the panel, not float. */
  .fye .ftr__talk .ftr__cta { width: 100%; }
  .fye .ftr__talk .ftr__social { margin-top: var(--s6); margin-bottom: var(--s6); }
}

/* Width comes from .ftr__mark img above — 94px, the measured live size. Do not
   add a second width here; two rules disagreeing about one number is a trap. */
@media (max-width: 768px) {
  .fye .ftr__mark { display: flex; justify-content: center; margin-bottom: var(--s6); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Monogram" },
    {
      "type": "text", "id": "mono_url", "label": "Monogram URL",
      "info": "A Files URL. Plain URL, not an image picker \u2014 an SVG cannot render through a picker.",
      "default": "https://cdn.shopify.com/s/files/1/0972/5391/7056/files/FYE-initial-logo.svg?v=1771578232"
    },
    { "type": "header", "content": "Talk to us" },
    { "type": "text", "id": "talk_heading", "label": "Heading", "default": "Talk to us" },
    { "type": "text", "id": "phone", "label": "Phone", "default": "0208 178 6687" },
    { "type": "text", "id": "hours", "label": "Opening hours", "default": "Mon-Fri, 9am-6pm" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@foryoureternity.com" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp link" },
    { "type": "url", "id": "instagram_url", "label": "Instagram link" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Book consultation" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Brand row" },
    { "type": "text", "id": "strapline", "label": "Strapline", "default": "Beautiful jewellery. Ethically made. Fairly priced." },
    { "type": "richtext", "id": "mission", "label": "Mission text" },
    { "type": "header", "content": "Newsletter" },
    { "type": "text", "id": "signup_heading", "label": "Heading", "default": "Keep up to date" },
    { "type": "text", "id": "signup_note", "label": "Note", "default": "New designs, guides and offers." },
    { "type": "header", "content": "Legal" },
    { "type": "richtext", "id": "legal", "label": "Company details" },
    { "type": "link_list", "id": "policy_menu", "label": "Policy menu" }
  ],
  "blocks": [
    {
      "type": "links",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
