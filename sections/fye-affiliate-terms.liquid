{% stylesheet %}
/* Scoped to .fye-legal. The 900px measure is deliberate and not a ch value:
   this document contains three four-column tables, and a prose measure would
   force them to scroll on desktop. Ported from live 03/09/2026, converted to
   tokens; the legal text above is byte-identical to the source. */
.fye .fye-legal {
  max-width: 900px;
  margin-inline: auto;
  padding-inline: var(--gutter);
}

.fye .fye-legal .fye-lede {
  font-size: var(--fs-body-lg);
  font-weight: var(--fw-light);
  line-height: 1.55;
  margin-bottom: var(--s3);
}
.fye .fye-legal .fye-meta {
  font-size: var(--fs-fine);
  color: var(--ink-soft);
  margin-bottom: var(--s5);
}
.fye .fye-legal .fye-small { font-size: var(--fs-fine); color: var(--ink-soft); margin: 0; }

/* The plain-English summary sits on ivory so it reads as a preface rather
   than as clause zero. */
.fye .fye-legal .fye-summary {
  background: var(--ivory);
  padding: var(--s6);
  margin: var(--s6) 0 var(--s8);
}
.fye .fye-legal .fye-summary h2 {
  font-size: var(--fs-h4);
  margin: 0 0 var(--s3);
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
}
.fye .fye-legal .fye-summary ul { margin: 0 0 var(--s3); padding-left: var(--s5); }
.fye .fye-legal .fye-summary li { margin-bottom: var(--s2); font-size: var(--fs-body); }

/* Sentence case on clause headings, against the brand default of uppercase
   display type: "22. Suspension and termination" in caps reads as a shout,
   and a numbered agreement needs to be scannable rather than styled. */
.fye .fye-legal h2 {
  font-size: var(--fs-h3);
  margin: var(--s8) 0 var(--s2);
  text-transform: none;
}
.fye .fye-legal h2.fye-appendix {
  border-top: var(--hairline);
  padding-top: var(--s7);
}
.fye .fye-legal h3 {
  font-size: var(--fs-body);
  font-weight: var(--fw-medium);
  margin: var(--s5) 0 var(--s1);
  text-transform: none;
}

.fye .fye-legal ol.fye-clause { padding-left: var(--s6); margin: 0 0 var(--s2); }
.fye .fye-legal ol.fye-clause > li {
  margin-bottom: var(--s3);
  font-size: var(--fs-body);
  line-height: 1.6;
}
/* lower-alpha on sub-clauses so a cross-reference to "clause 7.1(a)" can be
   followed. Do not change to decimal: the document says (a), (b), (c). */
.fye .fye-legal ol.fye-sub {
  padding-left: var(--s6);
  margin: var(--s2) 0 var(--s1);
  list-style: lower-alpha;
}
.fye .fye-legal ol.fye-sub > li {
  margin-bottom: var(--s2);
  font-size: var(--fs-body);
  line-height: 1.6;
}

.fye .fye-legal table.fye-t {
  width: 100%;
  border-collapse: collapse;
  margin: var(--s4) 0 var(--s5);
  font-size: var(--fs-small);
}
.fye .fye-legal table.fye-t th {
  background: var(--teal);
  color: var(--on-dark);
  text-align: left;
  padding: var(--s2) var(--s3);
  font-weight: var(--fw-medium);
}
.fye .fye-legal table.fye-t td {
  border: var(--hairline);
  padding: var(--s2) var(--s3);
  vertical-align: top;
}

/* The confirmed-calculation note, on mist, because getting the 5% + 5% maths
   wrong is the single most likely dispute in the whole agreement. */
.fye .fye-legal .fye-note {
  background: var(--mist);
  padding: var(--s4) var(--s5);
  margin: var(--s4) 0 var(--s6);
}
.fye .fye-legal .fye-note p { margin: 0; font-size: var(--fs-small); line-height: 1.6; }

/* 749 is the theme's table breakpoint, not the 600 this arrived with. */
@media (max-width: 749px) {
  .fye .fye-legal table.fye-t { font-size: var(--fs-fine); }
  .fye .fye-legal table.fye-t td,
  .fye .fye-legal table.fye-t th { padding: var(--s2); }
}
{% endstylesheet %}


