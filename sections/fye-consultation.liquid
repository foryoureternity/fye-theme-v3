{%- comment -%}
  fye-consultation — the booking CTA band. 8 uses.

  index, page.about-us, page.about-us-v2, page.affiliate-programme,
  page.engagement-rings, page.eternity-rings, page.wedding-rings, and the
  layout (so it appears sitewide where a template does not place its own).

  Setting IDs kept: `band`, `eyebrow`, `heading`, `lead`, `btn_label`,
  `btn_link`; `type` and `label` per contact block.

  The contact blocks only ever carried a type and a label on the live site, so
  the href is derived from the label — a phone number becomes tel:, an address
  becomes mailto:. `link` is a new optional setting for the cases that cannot
  be derived (WhatsApp), and wins when set.

  WhatsApp gets the conversation icon, not the WhatsApp logo — see the note in
  snippets/icon.liquid.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'teal'
-%}

<section class="consult band band--{{ band }}" data-screen-label="Consultation CTA">
  <div class="wrap consult__inner">
    <div class="consult__words">
      {%- if s.eyebrow != blank -%}
        <p class="eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}
        <h2 class="consult__heading">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.lead != blank -%}
        <p class="lead consult__lead">{{ s.lead }}</p>
      {%- endif -%}
    </div>

    <div class="consult__actions">
      {%- if s.btn_label != blank and s.btn_link != blank -%}
        <a class="btn" href="{{ s.btn_link }}">{{ s.btn_label }}</a>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="consult__contacts">
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              assign href = b.link
              case b.type
                when 'phone'
                  assign ic = 'phone'
                  if href == blank
                    assign href = b.label | remove: ' ' | remove: '(' | remove: ')' | prepend: 'tel:'
                  endif
                when 'email'
                  assign ic = 'mail'
                  if href == blank
                    assign href = b.label | strip | prepend: 'mailto:'
                  endif
                when 'whatsapp'
                  assign ic = 'message'
                else
                  assign ic = 'pin'
              endcase
            -%}
            {%- if b.label != blank -%}
              <li class="consult__contact" {{ block.shopify_attributes }}>
                {%- if href != blank -%}
                  <a class="consult__contact-link" href="{{ href }}">
                    {%- render 'icon', name: ic, class: 'icon--sm' -%}
                    <span>{{ b.label }}</span>
                  </a>
                {%- else -%}
                  <span class="consult__contact-link">
                    {%- render 'icon', name: ic, class: 'icon--sm' -%}
                    <span>{{ b.label }}</span>
                  </span>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* Words left, actions right; one column below 900. */
.fye .consult__inner {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: var(--s10);
  align-items: center;
}
.fye .consult__heading { margin-bottom: var(--s4); }
.fye .consult__lead { max-width: 46ch; }
.fye .consult__actions {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--s6);
}
.fye .consult__contacts {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s3) var(--s6);
  list-style: none;
  margin: 0;
  padding: 0;
}
.fye .consult__contact { margin: 0; }
.fye .consult__contact-link {
  display: inline-flex;
  align-items: center;
  gap: var(--s2);
  min-height: 44px;
  font-size: var(--fs-small);
}

@media (max-width: 900px) {
  .fye .consult__inner { grid-template-columns: 1fr; gap: var(--s7); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Consultation CTA",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Personal guidance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still unsure where to start?" },
    { "type": "text", "id": "lead", "label": "Supporting line", "default": "Book a free consultation — in person, by phone or video." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Book a free consultation" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    {
      "type": "select", "id": "band", "label": "Background", "default": "teal",
      "options": [
        { "value": "teal",  "label": "Teal" },
        { "value": "sage",  "label": "Sage" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "mist",  "label": "Mist" }
      ]
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "contact",
      "name": "Contact",
      "settings": [
        {
          "type": "select", "id": "type", "label": "Kind", "default": "phone",
          "options": [
            { "value": "phone",    "label": "Phone" },
            { "value": "email",    "label": "Email" },
            { "value": "whatsapp", "label": "WhatsApp" },
            { "value": "address",  "label": "Address" }
          ]
        },
        { "type": "text", "id": "label", "label": "Text", "default": "0208 178 6687" },
        { "type": "url", "id": "link", "label": "Link", "info": "Phone and email links are worked out from the text. Set this for WhatsApp." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Consultation CTA",
      "blocks": [{ "type": "contact" }, { "type": "contact" }]
    }
  ]
}
{% endschema %}
