{%- comment -%}
  fye-consultation — the closing "book a consultation" band.

  Setting IDs frozen: `eyebrow`, `heading`, `lead`, `btn_label`, `btn_link`,
  `band`, plus `btn2_*` for the optional second button; contact blocks keep
  `type`, `label`, `link`.

  LAYOUT IS LIVE'S, read from the live theme: a centred column — eyebrow,
  flanked heading, lead, button, contact row. Gap 22px, flank gap 26px, lead
  capped at 620px, contacts 13px with 12/28px gaps.

  I built this as two columns first, having guessed wrong about which of two
  screenshots was live. If it ever needs changing again, read live's section
  before moving anything.

  Type sizes are stated here rather than inherited, deliberately: this is a
  closing strip, and its heading is a step DOWN from the section-header scale
  (22-26px against the h2 scale). That is live's judgement and it is right —
  at full h2 the band competes with the sections above it.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'teal'
  assign has_btn2 = false
  if s.btn2_label != blank
    assign has_btn2 = true
  endif
  assign btn_style = 'btn--onteal'
  if band == 'sage'
    assign btn_style = 'btn--ghost-light'
  endif
-%}

<div class="band band--{{ band }}" data-screen-label="Consultation CTA">
  <div class="wrap">
    <div class="consult">

      {%- if s.eyebrow != blank -%}
        <p class="consult__eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}

      {%- if s.heading != blank -%}
        <h2 class="heading-flank consult__heading">{{ s.heading }}</h2>
      {%- endif -%}

      {%- if s.lead != blank -%}
        <p class="consult__lead">{{ s.lead }}</p>
      {%- endif -%}

      {%- if has_btn2 -%}<div class="consult__btns">{%- endif -%}
        {%- if s.btn_label != blank -%}
          <a class="btn {{ btn_style }}" href="{{ s.btn_link | default: '#' }}">{{ s.btn_label }}</a>
        {%- endif -%}
        {%- if has_btn2 -%}
          <a class="btn btn--ghost-light" href="{{ s.btn2_link | default: '#' }}"
            {%- if s.btn2_new_tab %} target="_blank" rel="noopener"{% endif -%}>{{ s.btn2_label }}</a>
        {%- endif -%}
      {%- if has_btn2 -%}</div>{%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="consult__contact">
          {%- for block in section.blocks -%}
            {%- liquid
              assign b = block.settings
              assign clink = b.link
              if clink == blank
                case b.type
                  when 'phone'
                    assign clink = 'tel:+442081786687'
                  when 'email'
                    assign clink = 'mailto:hello@foryoureternity.com'
                  when 'whatsapp'
                    assign clink = 'https://wa.me/447840042922'
                endcase
              endif
              assign new_tab = false
              if b.type == 'whatsapp'
                assign new_tab = true
              endif
            -%}
            <a href="{{ clink }}"{% if new_tab %} target="_blank" rel="noopener"{% endif %} {{ block.shopify_attributes }}>
              {%- render 'icon', name: b.type, class: 'icon--sm' -%}
              <span>{{ b.label }}</span>
            </a>
          {%- endfor -%}
        </div>
      {%- endif -%}

    </div>
  </div>
</div>

{% stylesheet %}
/* Centred column. gap 22px is live's — the eyebrow, heading, lead and button
   are one stack, not four spaced elements. */
.fye .consult {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 22px;
  text-align: center;
}

.fye .consult__eyebrow {
  margin: 0;
  font-size: 11px;
  font-weight: var(--fw-medium);
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: rgba(242, 241, 232, 0.6);
}
.fye .band--sage .consult__eyebrow { color: rgba(255, 255, 255, 0.75); }

/* A step DOWN from the h2 scale: this is a closing strip, and at full section
   scale it competes with the sections above it. Live's clamp, kept. */
.fye .consult__heading {
  margin: 0;
  font-family: var(--font-display);
  font-weight: 400;
  font-size: clamp(22px, 1.4rem + 0.7vw, 26px);
  line-height: 1.2;
  letter-spacing: 0.06em;
  text-transform: uppercase;
  color: var(--ivory);
  /* 26px between the heading and its hairlines, not the core --s5. */
  gap: 26px;
}
.fye .band--sage .consult__heading { color: #fff; }

.fye .consult__lead {
  margin: 0;
  max-width: 620px;
  font-size: clamp(17px, 1rem + 0.3vw, 19px);
  font-weight: var(--fw-light);
  line-height: 1.55;
  color: rgba(242, 241, 232, 0.85);
  text-wrap: pretty;
}
.fye .band--sage .consult__lead { color: rgba(255, 255, 255, 0.9); }

.fye .consult__btns { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; }

.fye .consult__contact {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12px 28px;
  margin-top: 8px;
}
.fye .consult__contact a {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  /* 44px: these measured 21px on 02/09/2026 — 13px type with no vertical
     padding. The height is padding around live's type size, so the band's
     measured spacing is unchanged; only the tap area grows. */
  min-height: 44px;
  font-size: 13px;
  letter-spacing: 0.04em;
  color: var(--ivory);
  text-decoration: none;
}
.fye .band--sage .consult__contact a { color: #fff; }
.fye .consult__contact a:hover { color: var(--sage); }
.fye .band--sage .consult__contact a:hover { color: var(--ivory); }
.fye .consult__contact :where(svg) { width: 16px; height: 16px; }

/* Buttons for a dark ground. */
.fye .consult .btn--onteal { background: var(--ivory); border-color: var(--ivory); color: var(--teal); }
.fye .consult .btn--onteal:hover { background: #fff; border-color: #fff; color: var(--teal); }
.fye .consult .btn--ghost-light { background: transparent; border-color: rgba(255, 255, 255, 0.6); color: #fff; }
.fye .consult .btn--ghost-light:hover { background: #fff; border-color: #fff; color: var(--teal); }

/* The global focus ring is teal, which all but disappears on this band. */
.fye .consult .btn:focus-visible,
.fye .consult__contact a:focus-visible { outline: 2px solid var(--ivory); outline-offset: 3px; }

@media (max-width: 560px) {
  .fye .consult__btns { width: 100%; flex-direction: column; align-items: stretch; }
  .fye .consult__btns .btn { width: 100%; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Consultation CTA",
  "tag": "section",
  "settings": [
    {
      "type": "select", "id": "band", "label": "Background", "default": "teal",
      "options": [
        { "value": "teal", "label": "Eternal teal" },
        { "value": "sage", "label": "Sage green" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Personal Guidance" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Still Unsure Where to Start?" },
    { "type": "textarea", "id": "lead", "label": "Intro text", "default": "Book a free consultation — in person, by phone or video." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Book a Free Consultation" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "header", "content": "Second button (optional)" },
    { "type": "text", "id": "btn2_label", "label": "Second button label", "info": "Leave blank for the usual single-button band." },
    { "type": "url", "id": "btn2_link", "label": "Second button link" },
    { "type": "checkbox", "id": "btn2_new_tab", "label": "Open second button in a new tab", "default": false }
  ],
  "blocks": [
    {
      "type": "contact",
      "name": "Contact link",
      "settings": [
        {
          "type": "select", "id": "type", "label": "Type", "default": "phone",
          "options": [
            { "value": "phone",    "label": "Phone" },
            { "value": "email",    "label": "Email" },
            { "value": "whatsapp", "label": "WhatsApp" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label", "default": "0208 178 6687" },
        { "type": "url", "id": "link", "label": "Link", "info": "Optional — built from the type when empty." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Consultation CTA",
      "blocks": [
        { "type": "contact", "settings": { "type": "phone" } },
        { "type": "contact", "settings": { "type": "email", "label": "hello@foryoureternity.com" } }
      ]
    }
  ]
}
{% endschema %}
