{%- comment -%}
  fye-hero — the pattern every content section follows. Read this before
  writing another one. 68 uses, the most of any section.

  THE CONTRACT:
    - Root element is `.band band--{colour}` + an inner `.wrap`.
    - The `band` setting picks the ground. That is the ONLY thing controlling
      background colour, and --sect-y is the ONLY thing controlling padding.
    - This section declares NO padding, NO colours, NO breakpoints.
      Everything comes from fye-core.css.
    - Section CSS below is scoped `.fye .hero`, never a bare `.hero`.

  Setting IDs are frozen to match the old theme so existing JSON templates
  keep working. Do not rename them.

  ADDED 27/08/2026, so the homepage hero can be built without raw HTML
  The live homepage hero was six blocks of hand-written HTML in text settings —
  an <h1> with fourteen inline styles, two <a> tags with their own colours and
  hover states, and two spacer blocks whose only job was margin. All of it is
  now settings:
    - `align` — the CSS for a left-aligned hero already existed with no way to
      reach it.
    - `logo_url`, `logo_alt`, `logo_width` — a wordmark above the heading. A
      text URL rather than an image picker because the live value is a Files
      URL, not a shop_images reference.
    - `link_label`, `link_url` — the quiet underlined link under the buttons
      ("Or book a free London or online consultation").
    - `heading_style` — see below.

  DEVIATION FROM THE BRAND BOOK, and why
  The brand book says H1 is Tenor Sans UPPERCASE. That is right for two or
  three words ("Timeless Engagement Rings") and wrong for the homepage's h1,
  which is a full sentence of 100 characters. Set in uppercase at the H1 scale
  it is both unreadable and shouty — the live site already renders it sentence
  case at a smaller size, which was the correct instinct. So `heading_style`
  offers:
    display  — uppercase, tracked, full H1 scale. The brand default.
    sentence — sentence case, one step down the scale, tracking relaxed.
  Use `sentence` only for a heading that is genuinely a sentence.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'ivory'
  assign align = s.align | default: 'center'
  assign hstyle = s.heading_style | default: 'display'
  assign hero_alt = s.heading | default: shop.name | strip_html
  assign has_img = false
  if s.image != blank
    assign has_img = true
  endif
-%}

<div class="band band--{{ band }} hero hero--{{ align }}{% if has_img %} hero--media{% endif %}">
  {%- if has_img -%}
    <div class="hero__media scrim">
      {{ s.image | image_url: width: 2400 | image_tag:
         alt: hero_alt,
         class: 'hero__img',
         loading: 'eager',
         sizes: '100vw',
         widths: '600,900,1200,1600,2000,2400' }}
    </div>
  {%- endif -%}

  <div class="wrap hero__in">
    {%- if s.eyebrow != blank -%}
      <p class="eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}

    {%- if s.heading != blank -%}
      <h1 class="hero__title hero__title--{{ hstyle }}">{{ s.heading }}</h1>
    {%- endif -%}

    {%- comment -%}
      The wordmark sits BELOW the heading, because the heading is written to
      run into it — "Wedding Rings by" / [FOR YOUR ETERNITY]. Above the
      heading it reads as a stray mark and the sentence dangles.
    {%- endcomment -%}
    {%- if s.logo_url != blank -%}
      <img class="hero__logo" src="{{ s.logo_url }}" alt="{{ s.logo_alt | default: shop.name | escape }}"
        style="--logo-w: {{ s.logo_width | default: 250 }}px;" loading="eager">
    {%- endif -%}

    {%- if s.subheading != blank -%}
      <p class="lead hero__sub">{{ s.subheading }}</p>
    {%- endif -%}

    {%- if s.button_label != blank -%}
      <div class="row hero__actions">
        <a class="btn" href="{{ s.button_link | default: '#' }}">{{ s.button_label }}</a>
        {%- if s.button2_label != blank -%}
          <a class="btn btn--outline" href="{{ s.button2_link | default: '#' }}">{{ s.button2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if s.link_label != blank -%}
      <a class="hero__link" href="{{ s.link_url | default: '#' }}">{{ s.link_label }}</a>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.fye .hero__in {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s5);
  text-align: center;
}
/* Left-aligned heroes run wide: on a full-bleed photograph the centred 1320px
   measure left a 124px gap before the copy at laptop width, which reads as a
   mistake rather than a margin. Live uses 1368 plus the gutter. */
.fye .hero--left .hero__in {
  align-items: flex-start;
  text-align: left;
  max-width: var(--maxw-wide);
  /* Twice live's 24px gutter. The left-aligned hero is the only place the
     copy has a real left edge against a full-bleed photograph, and at one
     gutter it sat too close to it. */
  padding-inline-start: 48px;
}
@media (max-width: 560px) {
  /* 48px of a 375px screen is a seventh of the width. Back to the gutter. */
  .fye .hero--left .hero__in { padding-inline-start: var(--gutter, 16px); }
}

/* Tightened against the heading it completes, not floated in the stack. */
.fye .hero__logo { width: var(--logo-w, 250px); height: auto; margin-top: calc(var(--s5) * -0.5); }
.fye .hero__sub { max-width: 56ch; }
.fye .hero__actions { justify-content: center; margin-top: var(--s3); }
.fye .hero--left .hero__actions { justify-content: flex-start; }

/* Brand default: uppercase, tracked, short. */
.fye .hero__title--display { max-width: 24ch; }

/* A heading that is a sentence. One step down the scale, no uppercase, and a
   wider measure because sentences need line length. See the note above. */
.fye .hero__title--sentence {
  font-size: var(--fs-h2);
  letter-spacing: 0.02em;
  text-transform: none;
  max-width: 34ch;
}

/* The quiet secondary link. Underlined rather than a third button, so it does
   not compete with the two that matter. */
.fye .hero__link {
  font-size: var(--fs-small);
  text-decoration: underline;
  text-underline-offset: 4px;
}

/* With a photograph: the band becomes the frame, the image fills it, and type
   sits on the brand's teal scrim. Padding still comes from --sect-y. */
.fye .hero--media { position: relative; overflow: hidden; }
/* 42% is tuned for a mid-tone photograph. The homepage hero is pale skin and a
   white ring, where ivory type at 42% is not readable — 55%, measured against
   the lightest area of that image. */
.fye .hero--media .hero__media { position: absolute; inset: 0; --scrim: rgba(35, 61, 71, 0.55); }
.fye .hero--media .hero__img { width: 100%; height: 100%; object-fit: cover; }
/* width: 100% is load-bearing. .hero--media is display:flex, which makes this
   wrap a flex item — without an explicit width it shrink-to-fits its own text
   and .wrap's auto margins then centre that narrow box, indenting the copy by
   a few hundred px. See the ninth non-negotiable in conventions.md. */
.fye .hero--media .hero__in { position: relative; z-index: 1; width: 100%; }
.fye .hero--media .hero__in,
.fye .hero--media :where(h1, .eyebrow, .lead),
.fye .hero--media .hero__link { color: var(--on-dark); }
.fye .hero--media .btn { background: var(--ivory); border-color: var(--ivory); color: var(--teal); }
.fye .hero--media .btn:hover { background: var(--sage); border-color: var(--sage); color: var(--teal); }
.fye .hero--media .btn--outline { background: transparent; border-color: var(--ivory); color: var(--ivory); }
.fye .hero--media .btn--outline:hover { background: var(--ivory); color: var(--teal); }

/* A hero with a photograph needs height even when the copy is short. Not a
   setting: the old section had three (580/460/390) and they were the same
   proportion at every width. */
.fye .hero--media { min-height: 580px; display: flex; align-items: center; }
@media (max-width: 900px) { .fye .hero--media { min-height: 460px; } }
@media (max-width: 560px) { .fye .hero--media { min-height: 390px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Timeless engagement rings" },
    {
      "type": "select", "id": "heading_style", "label": "Heading style", "default": "display",
      "info": "Sentence case for a heading that is a full sentence — uppercase is for two or three words.",
      "options": [
        { "value": "display",  "label": "Uppercase display" },
        { "value": "sentence", "label": "Sentence case" }
      ]
    },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Optional. Type sits on a teal scrim when set." },
    { "type": "header", "content": "Logo" },
    { "type": "text", "id": "logo_url", "label": "Logo URL", "info": "A file URL. Shown above the heading." },
    { "type": "text", "id": "logo_alt", "label": "Logo description" },
    { "type": "range", "id": "logo_width", "label": "Logo width", "default": 250, "min": 100, "max": 400, "step": 10, "unit": "px" },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label" },
    { "type": "url", "id": "button2_link", "label": "Second button link" },
    { "type": "text", "id": "link_label", "label": "Text link", "info": "A quieter third option, under the buttons." },
    { "type": "url", "id": "link_url", "label": "Text link URL" },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "center",
      "options": [
        { "value": "center", "label": "Centred" },
        { "value": "left",   "label": "Left" }
      ]
    },
    {
      "type": "select",
      "id": "band",
      "label": "Background band",
      "info": "Padding and type colour follow automatically.",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Champagne ivory" },
        { "value": "mist", "label": "Mist blue" },
        { "value": "teal", "label": "Eternal teal" },
        { "value": "sage", "label": "Sage green" }
      ],
      "default": "ivory"
    }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}

