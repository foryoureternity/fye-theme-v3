{%- comment -%}
  fye-hero — the pattern every content section follows. Read this before
  writing another one.

  THE CONTRACT:
    - Root element is `.band band--{colour}` + an inner `.wrap`.
    - The `band` setting picks the ground. That is the ONLY thing controlling
      background colour, and --sect-y is the ONLY thing controlling padding.
    - This section declares NO padding, NO colours, NO breakpoints.
      Everything comes from fye-core.css.
    - Section CSS below is scoped `.fye .hero`, never a bare `.hero`.

  Setting IDs are frozen to match the old theme so existing JSON templates
  keep working. Do not rename them.
{%- endcomment -%}
{%- liquid
  assign band = section.settings.band | default: 'ivory'
  assign has_img = false
  if section.settings.image != blank
    assign has_img = true
  endif
-%}

<div class="band band--{{ band }} hero{% if has_img %} hero--media{% endif %}">
  {%- if has_img -%}
    <div class="hero__media scrim">
      {{ section.settings.image | image_url: width: 2400 | image_tag:
         alt: section.settings.heading,
         class: 'hero__img',
         loading: 'eager',
         sizes: '100vw',
         widths: '600,900,1200,1600,2000,2400' }}
    </div>
  {%- endif -%}

  <div class="wrap hero__in">
    {%- if section.settings.eyebrow != blank -%}
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}

    {%- if section.settings.subheading != blank -%}
      <p class="lead hero__sub">{{ section.settings.subheading }}</p>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="row hero__actions">
        <a class="btn" href="{{ section.settings.button_link | default: '#' }}">{{ section.settings.button_label }}</a>
        {%- if section.settings.button2_label != blank -%}
          <a class="btn btn--outline" href="{{ section.settings.button2_link | default: '#' }}">{{ section.settings.button2_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
.fye .hero__in {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s5);
  text-align: center;
}
.fye .hero__title { max-width: 24ch; }
.fye .hero__sub { max-width: 56ch; }
.fye .hero__actions { justify-content: center; margin-top: var(--s3); }

/* With a photograph: the band becomes the frame, the image fills it, and type
   sits on the brand's teal scrim. Padding still comes from --sect-y. */
.fye .hero--media { position: relative; overflow: hidden; }
.fye .hero--media .hero__media { position: absolute; inset: 0; }
.fye .hero--media .hero__img { width: 100%; height: 100%; object-fit: cover; }
.fye .hero--media .hero__in { position: relative; z-index: 1; }
.fye .hero--media .hero__in,
.fye .hero--media :where(h1, .eyebrow, .lead) { color: var(--on-dark); }
.fye .hero--media .btn { background: var(--ivory); border-color: var(--ivory); color: var(--teal); }
.fye .hero--media .btn:hover { background: var(--sage); border-color: var(--sage); color: var(--teal); }
.fye .hero--media .btn--outline { background: transparent; border-color: var(--ivory); color: var(--ivory); }
.fye .hero--media .btn--outline:hover { background: var(--ivory); color: var(--teal); }

.fye .hero--left .hero__in { align-items: flex-start; text-align: left; }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "settings": [
    {
      "type": "select",
      "id": "band",
      "label": "Background band",
      "info": "Padding and type colour follow automatically.",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Champagne ivory" },
        { "value": "mist", "label": "Mist blue" },
        { "value": "teal", "label": "Eternal teal" },
        { "value": "sage", "label": "Sage green" }
      ],
      "default": "ivory"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Timeless engagement rings" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Optional. Type sits on a teal scrim when set." },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button label" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [
    { "name": "Hero" }
  ]
}
{% endschema %}
