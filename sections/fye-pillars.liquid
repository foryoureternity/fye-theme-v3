{%- comment -%}
  fye-pillars — image-topped values grid on an inverted band. 1 use:
  page.about-us ("What drives us").

  PORTED FROM LIVE'S `fye-pillars`, 25/08/2026 About Us handoff. Setting IDs
  kept: band · columns · eyebrow · heading; blocks carry image · image_alt ·
  heading · body.

  CHANGED FOR v3: `.fye-edu` wrapper dropped, tokens instead of edu-core
  variables, and the flanked heading uses the theme's own `sect-head` +
  `heading-flank` pattern rather than a local `.flanked`.

  WHY NOT fye-cards: that section's image slot is a 48px icon and its cells
  carry a box outline. Here each cell is a full-bleed square photograph with
  the heading and copy beneath, on a dark band with no box at all.

  ON THE INVERTED BANDS the body copy is dimmed with opacity rather than a
  hard-coded ivory alpha. Live wrote `rgba(242,241,232,.88)`, which is correct
  on teal and wrong on every other band — opacity inherits from whatever the
  band sets, so one rule works on all four. Live also noted .82 measured
  3.9:1 on sage-deep and .88 clears 4.5:1, so .88 it stays.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'teal'
  assign cols = s.columns | plus: 0
-%}

<section class="pil band band--{{ band }}" data-screen-label="About — what drives us">
  <div class="wrap">

    {%- if s.heading != blank -%}
      <div class="sect-head">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        <h2 class="heading-flank">{{ s.heading }}</h2>
      </div>
    {%- endif -%}

    <ul class="pil__grid" style="--cols: {{ cols }};">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            {%- comment -%}
              Cropped square SERVER SIDE, not just by object-fit: the srcset
              candidates then match the slot exactly, so a 640px square slot
              downloads a 640px square rather than a 640-wide portrait that
              the browser crops after paying for it.
            {%- endcomment -%}
            {{ b.image | image_url: width: 640, height: 640, crop: 'center' | image_tag:
               loading: 'lazy',
               widths: '320, 480, 640, 900',
               sizes: '(max-width: 560px) 92vw, (max-width: 900px) 46vw, 24vw',
               class: 'pil__img',
               alt: b.image_alt }}
          {%- endif -%}
          {%- if b.heading != blank -%}
            <h3 class="pil__h">{{ b.heading }}</h3>
          {%- endif -%}
          {%- if b.body != blank -%}
            <p class="pil__p">{{ b.body }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{% stylesheet %}
.fye .pil__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
  gap: var(--s7);
}
.fye .pil__grid > li { margin: 0; display: flex; flex-direction: column; gap: var(--s4); }
.fye .pil__img { width: 100%; aspect-ratio: 1; object-fit: cover; display: block; }
.fye .pil__h {
  margin: 0;
  font-family: var(--font-display);
  font-size: var(--fs-small);
  font-weight: var(--fw-regular);
  letter-spacing: 0.06em;
  line-height: 1.35;
  text-transform: uppercase;
}
/* opacity, not a hard-coded ivory alpha — see the note at the top of the file. */
.fye .pil__p { margin: 0; font-size: var(--fs-small); line-height: 1.65; opacity: 0.88; }

@media (max-width: 900px) {
  .fye .pil__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s8) var(--s6); }
}
@media (max-width: 560px) {
  .fye .pil__grid { grid-template-columns: 1fr; gap: var(--s8); }
  /* Four square photographs stacked is a very long scroll on a phone. */
  .fye .pil__img { aspect-ratio: 4 / 3; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Pillars",
  "settings": [
    {
      "type": "select", "id": "band", "label": "Background", "default": "teal",
      "options": [
        { "value": "teal",  "label": "Eternal teal" },
        { "value": "sage",  "label": "Sage green" },
        { "value": "ivory", "label": "Champagne ivory" },
        { "value": "white", "label": "White" }
      ]
    },
    {
      "type": "select", "id": "columns", "label": "Columns", "default": "4",
      "info": "Two on tablet, one below 560px.",
      "options": [
        { "value": "2", "label": "Two" },
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" }
      ]
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photograph" },
        { "type": "text", "id": "image_alt", "label": "Photograph description" },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "textarea", "id": "body", "label": "Description" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Pillars",
      "blocks": [{ "type": "pillar" }, { "type": "pillar" }, { "type": "pillar" }, { "type": "pillar" }]
    }
  ]
}
{% endschema %}
