{%- comment -%}
  fye-related — a row of links to other guides. 58 uses.

  The bottom of nearly every guide page: three or four cards pointing at the
  next thing to read. Text only, no images — the guide library has no cover art
  for most pages, and a card that is mostly empty grey box reads worse than one
  that is honestly just words.

  Setting IDs kept exactly: `band`, `show_head`, `eyebrow`, `heading`; per card
  `kicker`, `title`, `desc`, `cta`, `link`.

  The whole card is the link, with the visible CTA text as the affordance
  rather than a separate anchor — one target, 44px+ tall, and no nested links
  for a screen reader to announce twice.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'ivory'
-%}

<section class="rel band band--{{ band }}" data-screen-label="Related guides">
  <div class="wrap">
    {%- render 'sect-head',
        show: s.show_head,
        eyebrow: s.eyebrow,
        heading: s.heading -%}

    {%- if section.blocks.size > 0 -%}
      <ul class="rel__grid">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          {%- if b.title != blank -%}
            <li class="rel__item" {{ block.shopify_attributes }}>
              <a class="rel__card card card--line card--pad" href="{{ b.link | default: '#' }}">
                {%- if b.kicker != blank -%}
                  <span class="eyebrow">{{ b.kicker }}</span>
                {%- endif -%}

                <span class="rel__title">{{ b.title }}</span>

                {%- if b.desc != blank -%}
                  <span class="rel__desc">{{ b.desc }}</span>
                {%- endif -%}

                {%- if b.cta != blank -%}
                  <span class="link rel__cta">
                    {{ b.cta }}
                    {%- render 'icon', name: 'arrow-right', class: 'icon--sm' -%}
                  </span>
                {%- endif -%}
              </a>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.fye .rel__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  gap: var(--grid-gap);
  list-style: none;
  margin: 0;
  padding: 0;
}
.fye .rel__item { margin: 0; display: flex; }

/* The CTA sits at the foot of every card regardless of description length, so
   a row of three does not look ragged. */
.fye .rel__card {
  display: flex;
  flex-direction: column;
  gap: var(--s3);
  width: 100%;
  transition: border-color var(--dur) var(--ease);
}
.fye .rel__card:hover { border-color: var(--sage); }
.fye .rel__title {
  font-family: var(--font-display);
  font-size: var(--fs-h4);
  letter-spacing: var(--tr-h2);
  text-transform: uppercase;
  color: var(--ink);
  transition: color var(--dur) var(--ease);
}
.fye .rel__card:hover .rel__title { color: var(--sage); }
.fye .rel__desc { font-size: var(--fs-small); color: var(--ink-soft); }
.fye .rel__cta { margin-top: auto; padding-top: var(--s3); border-bottom: 0; }
.fye .rel__cta .icon { transition: transform var(--dur) var(--ease); }
.fye .rel__card:hover .rel__cta .icon { transform: translateX(3px); }

/* On a dark band the card ground would be white-on-teal; keep it transparent
   with a hairline instead. */
.fye .band--teal .rel__card,
.fye .band--sage .rel__card { background: transparent; }

@media (prefers-reduced-motion: reduce) {
  .fye .rel__card:hover .rel__cta .icon { transform: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Related guides",
  "settings": [
    { "type": "checkbox", "id": "show_head", "label": "Show the header", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep exploring" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Related guides" },
    {
      "type": "select", "id": "band", "label": "Background", "default": "ivory",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "mist",  "label": "Mist" },
        { "value": "teal",  "label": "Teal" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "kicker", "label": "Eyebrow", "default": "Diamond education" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "desc", "label": "Description" },
        { "type": "text", "id": "cta", "label": "Link text", "default": "Read more" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Related guides", "blocks": [{ "type": "card" }, { "type": "card" }, { "type": "card" }] }
  ]
}
{% endschema %}
