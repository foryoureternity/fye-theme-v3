            { "value": "3", "label": "Three" },
            { "value": "4", "label": "Four" },
            { "value": "5", "label": "Five" }
          ]
        },
        {
          "type": "select", "id": "icon_size", "label": "Icon size", "default": "56",
          "options": [
            { "value": "40", "label": "Small" },
            { "value": "56", "label": "Medium" },
            { "value": "88", "label": "Large" }
          ]
        },
        {
          "type": "select", "id": "icon_style", "label": "Icon style", "default": "line",
          "options": [
            { "value": "line", "label": "Teal line art" },
            { "value": "colour", "label": "Colour or photograph" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 50,
  "presets": [
    { "name": "Ring finder", "blocks": [ { "type": "journey" }, { "type": "step" } ] }
  ]
