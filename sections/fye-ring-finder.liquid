        { "type": "textarea", "id": "options", "label": "Options", "info": "One per line: Label | value | icon.svg | note. All but the label are optional. Ranges as 1.00..1.49; two filters at once as carat=18ct&metal_colour=Rose Gold." },
        { "type": "header", "content": "Ask only sometimes" },
