    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Introduction" },
    { "type": "text", "id": "journeys_q", "label": "First question", "default": "What are you looking for?" },
    { "type": "text", "id": "flexible_label", "label": "Skip option label", "default": "I'm flexible", "info": "Ends every step and applies no filter. Keep it: it is what makes every ring reachable. Fork blocks never show it." },
    { "type": "header", "content": "Results" },
    { "type": "text", "id": "results_heading", "label": "Heading", "default": "Here are the rings that match" },
    { "type": "text", "id": "results_label", "label": "Collection link", "default": "See all matching rings" },
    { "type": "header", "content": "Second option — bespoke enquiry" },
    { "type": "paragraph", "content": "Shown beside the matching rings, at equal size. Keep both headings to a line so the two columns stay level." },
    { "type": "text", "id": "custom_heading", "label": "Heading", "default": "Or, let's design your perfect ring for you" },
    { "type": "textarea", "id": "custom_intro", "label": "Introduction", "default": "Tell us what you had in mind and we'll come back to you with custom options." },
    { "type": "text", "id": "custom_placeholder", "label": "Message placeholder", "default": "Anything you would like us to know — a stone, a budget, a date." },
    { "type": "text", "id": "custom_label", "label": "Button", "default": "Send my details" },
    { "type": "header", "content": "When nothing matches" },
    { "type": "paragraph", "content": "Shown instead of the two columns when a journey returns no rings. The enquiry form is then the only thing on screen." },
    { "type": "text", "id": "empty_heading", "label": "Heading", "default": "We'll design your ring for you" },
    { "type": "textarea", "id": "empty_intro", "label": "Introduction", "default": "Nothing in stock matches every answer you gave — which simply means yours is a ring we make rather than one we hold. Leave your details and we'll come back to you with designs and a price." },
    { "type": "text", "id": "custom_thanks_heading", "label": "Thank you heading", "default": "Thank you — that is with us" },
    { "type": "textarea", "id": "custom_thanks", "label": "Thank you message", "default": "Thank you. We'll be in touch shortly with options made for you." },
    { "type": "text", "id": "restart_label", "label": "Restart link", "default": "Start the finder again" },
    { "type": "header", "content": "Background" },
    {
      "type": "select", "id": "top_space", "label": "Space above", "default": "standard",
      "info": "Flush when a page banner sits directly above, which is the usual case.",
      "options": [
        { "value": "standard", "label": "Standard" },
        { "value": "tight", "label": "Tight" },
        { "value": "flush", "label": "Flush to the section above" }
      ]
    },
    {
      "type": "select", "id": "band", "label": "Background", "default": "ivory",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Champagne ivory" },
        { "value": "mist", "label": "Mist blue" }
      ]
    }
  ],
  "blocks": [
