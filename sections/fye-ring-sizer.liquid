{%- comment -%}
  fye-ring-sizer, the free ring sizer order form. 1 use:
  page.order-a-free-ring-sizer.

  NEW FILE, 03/09/2026. The page had been Klaviyo (Wy3kMk), then a Shopify
  Forms inline block (form 1114172) hosted by sections/apps.liquid. Ed,
  03/09/2026: no Shopify Forms. So this is Shopify's own {% form 'contact' %},
  the same mechanism as every popup and the contact page, and a submission
  arrives as a normal store enquiry. Consequences:

    - Nothing is written to a list or a CRM. The order is the email.
    - The postal address MUST be in the email body. Custom contact[...]
      fields do not show usefully in Shopify's notification (Ed, 01/09/2026),
      so the composer in fye-ui.js folds every field marked
      data-fye-popup-line into contact[body] on submit: name, phone, then
      the address block, then the optional note, consent and the page.
      Liquid writes a fallback body naming the form, for JavaScript off.

  THE COMPOSER IS THE POPUP SCRIPT, DELIBERATELY. This section carries
  data-fye-popup-panel and data-fye-popup-label on a plain element, exactly
  as fye-contact does, so the enquiry reads like every other one in the
  inbox. The dialog-only paths in that script are inert here.

  Required fields are the ones a label needs: name, email, address line 1,
  town, postcode. Line 2, telephone and the note are optional. No county:
  the postcode does the work, and a county the customer did not type has
  been printed onto a label before (see the ring-sizer memory, 04/08/2026).

  Layout: intro copy above, the form on the narrow reading measure. Field
  arrangement CSS only; inputs, labels and the 44px minimum come from
  fye-core's form rules.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'ivory'
  assign tag = s.heading_tag | default: 'h2'
  assign email_line = s.email_subject | default: 'Free ring sizer order'
-%}

<section class="rsz band band--{{ band }}" data-screen-label="Ring sizer form"
         data-fye-popup-panel="ring-sizer-page"
         data-fye-popup-label="{{ email_line | escape }}">
  <div class="wrap wrap--narrow">

    {%- if s.eyebrow != blank -%}
      <p class="eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}
    {%- if s.heading != blank -%}
      <{{ tag }} class="rsz__heading">{{ s.heading }}</{{ tag }}>
    {%- endif -%}
    {%- if s.intro != blank -%}
      <div class="lead rsz__intro">{{ s.intro }}</div>
    {%- endif -%}

    {%- form 'contact', id: 'rsz-form', class: 'rsz__form' -%}

      {%- if form.posted_successfully? -%}
        <div class="rsz__done panel" data-fye-popup-done>
          <h3 class="rsz__done-head">{{ s.success_heading | default: 'Thank you' }}</h3>
          <div>{{ s.success_body | default: '<p>We have your details and will post your ring sizer shortly. We will email you once it is on its way.</p>' }}</div>
        </div>
      {%- else -%}

        {%- if form.errors -%}
          <div class="rsz__errors" role="alert">
            <p>{{ form.errors | default_errors }}</p>
          </div>
        {%- endif -%}

        <fieldset class="rsz__group">
          <legend class="rsz__legend">{{ s.about_label | default: 'About you' }}</legend>

          <div class="rsz__pair">
            <div class="rsz__field">
              <label for="rsz-first">First name</label>
              <input id="rsz-first" type="text" name="contact[First name]" autocomplete="given-name" placeholder="First name" required data-fye-popup-line="First name">
            </div>
            <div class="rsz__field">
              <label for="rsz-last">Last name</label>
              <input id="rsz-last" type="text" name="contact[Last name]" autocomplete="family-name" placeholder="Last name" required data-fye-popup-line="Last name">
            </div>
          </div>

          <div class="rsz__pair">
            <div class="rsz__field">
              <label for="rsz-email">Email address</label>
              <input id="rsz-email" type="email" name="contact[email]" autocomplete="email" placeholder="you@email.com" required>
            </div>
            <div class="rsz__field">
              <label for="rsz-phone">Telephone <span class="rsz__opt">(optional)</span></label>
              <input id="rsz-phone" type="tel" name="contact[Telephone]" autocomplete="tel" placeholder="In case we need to check anything" data-fye-popup-line="Telephone">
            </div>
          </div>
        </fieldset>

        <fieldset class="rsz__group">
          <legend class="rsz__legend">{{ s.address_label | default: 'Where to post it' }}</legend>

          <div class="rsz__field">
            <label for="rsz-addr1">Address line 1</label>
            <input id="rsz-addr1" type="text" name="contact[Address line 1]" autocomplete="address-line1" placeholder="House number and street" required data-fye-popup-line="Address line 1">
          </div>
          <div class="rsz__field">
            <label for="rsz-addr2">Address line 2 <span class="rsz__opt">(optional)</span></label>
            <input id="rsz-addr2" type="text" name="contact[Address line 2]" autocomplete="address-line2" placeholder="Flat, building or area" data-fye-popup-line="Address line 2">
          </div>
          <div class="rsz__pair">
            <div class="rsz__field">
              <label for="rsz-town">Town or city</label>
              <input id="rsz-town" type="text" name="contact[Town]" autocomplete="address-level2" placeholder="Town or city" required data-fye-popup-line="Town">
            </div>
            <div class="rsz__field">
              <label for="rsz-postcode">Postcode</label>
              <input id="rsz-postcode" type="text" name="contact[Postcode]" autocomplete="postal-code" placeholder="Postcode" required data-fye-popup-line="Postcode">
            </div>
          </div>
        </fieldset>

        {%- if s.show_message -%}
          <div class="rsz__field">
            <label for="rsz-message">{{ s.message_label | default: 'Anything we should know?' }} <span class="rsz__opt">(optional)</span></label>
            <textarea id="rsz-message" name="contact[Message]" rows="3" data-fye-popup-message
                      placeholder="{{ s.message_placeholder | default: 'The ring it is for, a date you are working to, a size you already think you are…' | escape }}"></textarea>
          </div>
        {%- endif -%}

        {%- if s.show_consent -%}
          <label class="rsz__consent" for="rsz-consent">
            <input id="rsz-consent" type="checkbox" name="contact[Happy to be emailed]" value="Yes" data-fye-popup-consent>
            <span>{{ s.consent_text | default: "Yes, I'm happy for For Your Eternity to email me occasional ring advice. I can unsubscribe anytime." }}</span>
          </label>
        {%- endif -%}

        {%- comment -%}
          Liquid's fallback body, for JavaScript off. fye-ui.js rewrites this
          on submit with every data-fye-popup-line field, the note and the
          consent answer folded in.
        {%- endcomment -%}
        <input type="hidden" name="contact[body]" value="{{ email_line | escape }} (sent from {{ request.path }})" data-fye-popup-body>

        <div class="rsz__actions">
          <button class="btn" type="submit">{{ s.button_label | default: 'Send me a free ring sizer' }}</button>
          {%- if s.reassurance != blank -%}
            <p class="fine rsz__note">{{ s.reassurance }}</p>
          {%- endif -%}
        </div>

      {%- endif -%}

    {%- endform -%}
  </div>
</section>

{% stylesheet %}
.fye .rsz__heading { margin-bottom: var(--s4); }
.fye .rsz__intro { margin-bottom: var(--s8); max-width: 56ch; }
.fye .rsz__intro :where(p:last-child) { margin-bottom: 0; }

/* ---- form --------------------------------------------------------------- */
/* Inputs, labels, textareas and the 48px minimum come from fye-core's form
   rules. Only the arrangement is here. */
.fye .rsz__form { display: flex; flex-direction: column; gap: var(--s6); }
.fye .rsz__group { display: flex; flex-direction: column; gap: var(--s5); margin: 0; padding: 0; border: 0; min-width: 0; }
.fye .rsz__legend {
  padding: 0;
  margin-bottom: var(--s2);
  font-size: var(--fs-eyebrow);
  font-weight: var(--fw-medium);
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
  color: var(--ink-soft);
}
.fye .rsz__field { display: flex; flex-direction: column; }
.fye .rsz__pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s5); }
/* Sentence case inside an uppercase label, so it does not get the 11px
   micro-label allowance. 12px is the floor for anything read as words. */
.fye .rsz__opt { font-size: 12px; font-weight: var(--fw-light); letter-spacing: 0; text-transform: none; }
/* Shorter than the site default: this is a note, not a message. */
.fye .rsz__field :where(textarea) { min-height: 96px; }

/* An 18px checkbox is correct: the LABEL is the tap target, so it carries the
   44px minimum. Same rule as the contact page and the popups. */
.fye .rsz__consent {
  display: flex;
  align-items: flex-start;
  gap: var(--s3);
  min-height: 44px;
  padding-block: var(--s1);
  margin: 0;
  font-size: var(--fs-small);
  font-weight: var(--fw-light);
  letter-spacing: 0;
  line-height: 1.5;
  text-transform: none;
  color: var(--ink-soft);
}
.fye .rsz__consent input {
  flex: 0 0 18px;
  width: 18px;
  height: 18px;
  min-height: 0;
  margin-top: 2px;
  accent-color: var(--teal);
}

.fye .rsz__actions { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s3); }
.fye .rsz__note { margin: 0; }

.fye .rsz__errors { padding: var(--s3) var(--s4); background: var(--mist); font-size: var(--fs-small); }
.fye .rsz__errors :where(p) { margin: 0; }

.fye .rsz__done { display: flex; flex-direction: column; gap: var(--s3); }
.fye .rsz__done-head { font-size: var(--fs-h3); }

/* ---- reflow ------------------------------------------------------------- */
@media (max-width: 560px) {
  .fye .rsz__pair { grid-template-columns: 1fr; }
  .fye .rsz__actions { align-items: stretch; }
  .fye .rsz__note { text-align: center; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Ring sizer form",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Free, and posted the same or next working day" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Order your free ring sizer" },
    {
      "type": "select", "id": "heading_tag", "label": "Heading level", "default": "h2",
      "info": "h2 when the page banner above already carries the h1.",
      "options": [
        { "value": "h1", "label": "h1" },
        { "value": "h2", "label": "h2" }
      ]
    },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Tell us where to send it and we will pop a ring sizer in the post. It is the simplest way to find your size at home, and we are happy to talk it through if you are unsure.</p>" },
    { "type": "header", "content": "Form" },
    { "type": "text", "id": "about_label", "label": "First group label", "default": "About you" },
    { "type": "text", "id": "address_label", "label": "Address group label", "default": "Where to post it" },
    { "type": "checkbox", "id": "show_message", "label": "Include an optional note box", "default": true },
    { "type": "text", "id": "message_label", "label": "Note label", "default": "Anything we should know?" },
    { "type": "text", "id": "message_placeholder", "label": "Note placeholder", "default": "The ring it is for, a date you are working to, a size you already think you are…" },
    { "type": "checkbox", "id": "show_consent", "label": "Show the email consent tickbox", "default": true },
    { "type": "text", "id": "consent_text", "label": "Consent wording", "default": "Yes, I'm happy for For Your Eternity to email me occasional ring advice. I can unsubscribe anytime." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Send me a free ring sizer" },
    { "type": "text", "id": "reassurance", "label": "Line under the button", "default": "UK addresses only. Your details are used to post the sizer and reply to you, nothing else." },
    {
      "type": "text", "id": "email_subject", "label": "How this shows in the enquiry email", "default": "Free ring sizer order",
      "info": "The first line of the message we receive."
    },
    { "type": "header", "content": "After sending" },
    { "type": "text", "id": "success_heading", "label": "Heading", "default": "Thank you" },
    { "type": "richtext", "id": "success_body", "label": "Message", "default": "<p>We have your details and will post your ring sizer shortly. We will email you once it is on its way.</p>" },
    { "type": "header", "content": "Background" },
    {
      "type": "select", "id": "band", "label": "Background", "default": "ivory",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Champagne ivory" },
        { "value": "mist",  "label": "Mist blue" }
      ]
    }
  ],
  "presets": [{ "name": "Ring sizer form" }]
}
{% endschema %}
