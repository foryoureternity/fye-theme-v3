{%- comment -%}
  fye-shape-tiles — the diamond cut grid. 1 use: page.diamond-shapes.

  A NEW SECTION, and the only one this job adds. Conventions §10 says do not
  build unless nothing existing can carry the content, so the reasoning:

  The shape icons are SVG files in Shopify Files (icon101.svg to icon110.svg),
  the same ones `snippets/mm-shapes.liquid` renders in the mega menu. **An SVG
  cannot go through `image_url` or `image_tag`**, and `image_picker` will not
  offer one, so `fye-cards`, whose icon slot is an `image_picker`, physically
  cannot render them. `fye-chips` has no image slot at all. Everything else is
  text-only. Hence a section whose icon setting is TEXT holding a filename,
  resolved with `file_url` at render time.

  `file_url` rather than mm-shapes' hardcoded `foryoureternity.com/cdn/...`
  URL: the same file, but resolved by Shopify, so it survives a domain change
  and a store copy. mm-shapes should move to it too, next time it is touched.

  Each tile carries TWO destinations because a shopper arriving at "oval" wants
  one of two different things: a finished oval ring, or a loose oval stone to
  set. Live's version linked only to rings.

  Renders with no icon, with one link, or with neither: the icon slot collapses
  and the tile is still a readable definition. That matters because baguette has
  an icon nobody has drawn yet and only an eternity collection to point at.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'white'
  assign cols = s.columns | plus: 0
-%}

<section class="shp band band--{{ band }}" data-screen-label="Diamond shapes">
  <div class="wrap">

    {%- if s.show_head -%}
      <div class="sect-head">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="heading-flank">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.intro != blank -%}
          <p class="lead shp__intro">{{ s.intro }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="shp__grid" style="--cols: {{ cols }};">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign alt_text = b.name | default: 'Diamond shape'
        -%}
        <li class="shp__tile" {{ block.shopify_attributes }}>

          {%- if b.icon != blank -%}
            {%- comment -%}
              aria-hidden with an empty alt: the shape name is the next element
              and reading both gives "Oval Oval". 56px is the rendered size, so
              the attributes state it and the layout cannot shift.
            {%- endcomment -%}
            <img class="shp__icon" src="{{ b.icon | file_url }}" alt="" aria-hidden="true"
                 width="56" height="56" loading="lazy">
          {%- endif -%}

          {%- if b.name != blank -%}
            <h3 class="shp__name">{{ b.name }}</h3>
          {%- endif -%}

          {%- if b.sub != blank -%}
            <p class="shp__sub">{{ b.sub }}</p>
          {%- endif -%}

          {%- if b.rings_link != blank or b.stones_link != blank -%}
            <div class="shp__links">
              {%- if b.rings_link != blank -%}
                <a class="shp__link" href="{{ b.rings_link }}">
                  {{- b.rings_label | default: 'Rings' -}}
                  {%- render 'icon', name: 'arrow-right', size: 12 -%}
                  <span class="visually-hidden"> in {{ alt_text }}</span>
                </a>
              {%- endif -%}
              {%- if b.stones_link != blank -%}
                <a class="shp__link" href="{{ b.stones_link }}">
                  {{- b.stones_label | default: 'Loose stones' -}}
                  {%- render 'icon', name: 'arrow-right', size: 12 -%}
                  <span class="visually-hidden"> in {{ alt_text }}</span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}

        </li>
      {%- endfor -%}
    </ul>

    {%- if s.note != blank -%}
      <p class="fine shp__note">{{ s.note }}</p>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
.fye .shp__intro { margin-inline: auto; max-width: 60ch; }

.fye .shp__grid {
  list-style: none;
  margin: 0;
  padding: 0;
  display: grid;
  grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
  gap: var(--s7) var(--grid-gap);
}

/* A hairline on the tile rather than a full box: the grid reads as a set of
   definitions, which is what it is, not a row of cards to click. */
.fye .shp__tile {
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: var(--s2);
  padding-top: var(--s5);
  border-top: var(--hairline);
  min-width: 0;
}

.fye .shp__icon { display: block; width: 56px; height: 56px; margin-bottom: var(--s2); }

.fye .shp__name {
  margin: 0;
  font-family: var(--font-display);
  font-size: var(--fs-small);
  font-weight: var(--fw-regular);
  letter-spacing: 0.07em;
  line-height: 1.3;
  text-transform: uppercase;
}
.fye .shp__sub { margin: 0; font-size: var(--fs-small); line-height: 1.6; color: var(--ink-soft); }

.fye .shp__links { display: flex; flex-direction: column; gap: var(--s1); margin-top: var(--s2); }
.fye .shp__link {
  display: inline-flex;
  align-items: center;
  gap: var(--s1);
  min-height: 44px;
  font-size: var(--fs-eyebrow);
  font-weight: var(--fw-medium);
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
}
.fye .shp__link:hover { color: var(--sage); }
.fye .shp__link .icon { flex: none; transition: transform var(--dur) var(--ease); }
.fye .shp__link:hover .icon { transform: translateX(3px); }

.fye .shp__note { margin: var(--s8) 0 0; }

@media (max-width: 900px) {
  .fye .shp__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 749px) {
  .fye .shp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 560px) {
  .fye .shp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s6) var(--s5); }
  .fye .shp__icon { width: 44px; height: 44px; }
}
@media (prefers-reduced-motion: reduce) {
  .fye .shp__link .icon { transition: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Shape tiles",
  "settings": [
    { "type": "checkbox", "id": "show_head", "label": "Show the section heading", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "textarea", "id": "intro", "label": "Introduction" },
    { "type": "text", "id": "note", "label": "Note below the grid" },
    {
      "type": "select", "id": "columns", "label": "Columns", "default": "4",
      "info": "Three on tablet, two below 749px.",
      "options": [
        { "value": "3", "label": "Three" },
        { "value": "4", "label": "Four" },
        { "value": "5", "label": "Five" }
      ]
    },
    {
      "type": "select", "id": "band", "label": "Background", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Champagne ivory" },
        { "value": "mist", "label": "Mist blue" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "shape",
      "name": "Shape",
      "settings": [
        { "type": "text", "id": "name", "label": "Shape name" },
        { "type": "textarea", "id": "sub", "label": "Description" },
        {
          "type": "text", "id": "icon", "label": "Icon file name",
          "info": "A file in Content \u203a Files, including the extension, e.g. icon101.svg. A text field rather than an image picker because the icons are SVG, which the image picker cannot offer."
        },
        { "type": "url", "id": "rings_link", "label": "Rings link" },
        { "type": "text", "id": "rings_label", "label": "Rings link text", "default": "Rings" },
        { "type": "url", "id": "stones_link", "label": "Loose stones link" },
        { "type": "text", "id": "stones_label", "label": "Loose stones link text", "default": "Loose stones" }
      ]
    }
  ],
  "max_blocks": 14,
  "presets": [
    {
      "name": "Shape tiles",
      "blocks": [{ "type": "shape" }, { "type": "shape" }, { "type": "shape" }, { "type": "shape" }]
    }
  ]
}
{% endschema %}
