{%- comment -%}
  fye-terms — a numbered list of terms with definitions. 104 uses, the
  most-used section in the theme after the hero.

  This is the guide library's workhorse: "The Four Cs", "Setting styles",
  "Metal options" — anywhere a guide enumerates things with a name and an
  explanation. FYE-original and already lean, so this is a port to the design
  system rather than a rebuild.

  Setting IDs kept exactly: `band`, `columns`, `numbering`, `narrow`,
  `show_head`, `eyebrow`, `heading`, `intro`, `note`; per block `number`,
  `heading`, `body`, `meta`.

  `numbering` decides what sits in the marker: the block's own `number` when it
  has one, otherwise a counter. `none` drops the marker and the indent with it,
  which is right for a list of named things that are not sequential.

  Rendered as a <dl>. A term and its definition are exactly that, and it gives
  screen readers the pairing for free — the old markup was nested divs.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'white'
  assign cols = s.columns | default: 2
  assign numbering = s.numbering | default: 'numbers'
-%}

<section class="terms band band--{{ band }} terms--{{ numbering }}" data-screen-label="Terms and lists">
  <div class="wrap{% if s.narrow %} wrap--narrow{% endif %}">
    {%- render 'sect-head',
        show: s.show_head,
        eyebrow: s.eyebrow,
        heading: s.heading,
        intro: s.intro -%}

    {%- if section.blocks.size > 0 -%}
      <dl class="terms__list" style="--tcols: {{ cols }};">
        {%- for block in section.blocks -%}
          {%- liquid
            assign b = block.settings
            assign marker = b.number
            if marker == blank
              assign marker = forloop.index
            endif
          -%}
          <div class="terms__item" {{ block.shopify_attributes }}>
            {%- if numbering != 'none' -%}
              <span class="terms__marker" aria-hidden="true">{{ marker }}</span>
            {%- endif -%}

            <div class="terms__text">
              {%- if b.heading != blank -%}
                <dt class="terms__term">
                  {{ b.heading }}
                  {%- if b.meta != blank -%}
                    <span class="terms__meta">{{ b.meta }}</span>
                  {%- endif -%}
                </dt>
              {%- endif -%}

              {%- if b.body != blank -%}
                <dd class="terms__def">{{ b.body }}</dd>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </dl>
    {%- endif -%}

    {%- if s.note != blank -%}
      <p class="fine terms__note">{{ s.note }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
.fye .terms__list {
  display: grid;
  grid-template-columns: repeat(var(--tcols, 2), minmax(0, 1fr));
  gap: var(--s8) var(--s10);
  margin: 0;
}
.fye .terms__item { display: flex; gap: var(--s5); align-items: flex-start; }

/* The marker is Tenor Sans at heading scale, sitting in the margin like a
   chapter number — not a bullet, and not a coloured circle. */
.fye .terms__marker {
  flex: 0 0 auto;
  min-width: 1.6em;
  font-family: var(--font-display);
  font-size: var(--fs-h3);
  line-height: 1.1;
  color: var(--sage);
}
.fye .terms--none .terms__marker { display: none; }

.fye .terms__text { display: flex; flex-direction: column; gap: var(--s2); }
.fye .terms__term {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: var(--s3);
  font-family: var(--font-display);
  font-size: var(--fs-h4);
  letter-spacing: var(--tr-h2);
  text-transform: uppercase;
  color: var(--ink);
}
.fye .terms__meta {
  font-family: var(--font-body);
  font-size: var(--fs-fine);
  letter-spacing: 0;
  text-transform: none;
  color: var(--ink-soft);
}
.fye .terms__def { margin: 0; color: var(--ink-soft); }
.fye .terms__note { margin-top: var(--s8); }

@media (max-width: 900px) {
  .fye .terms__list { grid-template-columns: 1fr; gap: var(--s7); }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Terms and lists",
  "settings": [
    { "type": "checkbox", "id": "show_head", "label": "Show the header", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Four Cs" },
    { "type": "textarea", "id": "intro", "label": "Intro" },
    { "type": "text", "id": "note", "label": "Footnote", "info": "Small print under the list." },
    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "columns", "label": "Columns", "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" }
      ]
    },
    {
      "type": "select", "id": "numbering", "label": "Markers", "default": "numbers",
      "info": "A block's own number wins over the automatic count.",
      "options": [
        { "value": "numbers", "label": "Numbered" },
        { "value": "none",    "label": "None" }
      ]
    },
    { "type": "checkbox", "id": "narrow", "label": "Narrow measure", "default": false },
    {
      "type": "select", "id": "band", "label": "Background", "default": "white",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "mist",  "label": "Mist" },
        { "value": "teal",  "label": "Teal" },
        { "value": "sage",  "label": "Sage" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "term",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "number", "label": "Marker", "info": "Leave empty to count automatically." },
        { "type": "text", "id": "heading", "label": "Term" },
        { "type": "richtext", "id": "body", "label": "Definition" },
        { "type": "text", "id": "meta", "label": "Aside", "info": "A short qualifier beside the term." }
      ]
    }
  ],
  "presets": [
    { "name": "Terms and lists", "blocks": [{ "type": "term" }, { "type": "term" }] }
  ]
}
{% endschema %}
