{%- comment -%}
  fye-testimonials — client quotes. 3 uses: index, page.about-us,
  page.about-us-v2.

  WHAT CHANGED, AND WHY YOU MAY WANT TO ARGUE WITH IT
  The old version was an autoplaying carousel: `enable_autoplay` true,
  `autoplay_seconds` 5.5, `transition_ms` 500. Those three settings are gone
  and it is now a static grid. Three reasons:
    - the brand rule is "no infinite decorative loops"; a carousel that
      restarts forever is exactly that;
    - a carousel hides five of six quotes behind a timer nobody waits for, and
      moving text under a reader's eye is an accessibility problem;
    - it needed JavaScript, and a grid needs none.
  Six short quotes fit on one screen as three columns. If Ed wants the carousel
  back, the settings IDs above are still free and it belongs in fye-ui.js with
  a pause control — not in this file.

  Setting IDs kept: `heading`, `avg_rating`; `quote`, `name`, `context`,
  `rating` per block.

  `rating` renders as stars with a text equivalent for screen readers. A block
  with no rating shows no stars rather than an empty row of five.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'ivory'
-%}

<section class="tmon band band--{{ band }}" data-screen-label="Testimonials">
  <div class="wrap">
    <div class="sect-head">
      {%- if s.heading != blank -%}
        <h2 class="heading-flank">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.avg_rating != blank -%}
        <p class="tmon__avg">
          {%- render 'icon', name: 'star', class: 'icon--sm' -%}
          <span>{{ s.avg_rating }} average</span>
        </p>
      {%- endif -%}
    </div>

    <div class="tmon__grid">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <figure class="tmon__item" {{ block.shopify_attributes }}>
          {%- if b.rating > 0 -%}
            <p class="tmon__stars">
              {%- for i in (1..b.rating) -%}
                {%- render 'icon', name: 'star', class: 'icon--sm' -%}
              {%- endfor -%}
              <span class="visually-hidden">{{ b.rating }} out of 5</span>
            </p>
          {%- endif -%}

          {%- if b.quote != blank -%}
            <blockquote class="tmon__quote">{{ b.quote }}</blockquote>
          {%- endif -%}

          {%- if b.name != blank or b.context != blank -%}
            <figcaption class="tmon__by">
              {%- if b.name != blank -%}
                <span class="tmon__name">{{ b.name }}</span>
              {%- endif -%}
              {%- if b.context != blank -%}
                <span class="tmon__context">{{ b.context }}</span>
              {%- endif -%}
            </figcaption>
          {%- endif -%}
        </figure>
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
.fye .tmon__avg {
  display: inline-flex;
  align-items: center;
  gap: var(--s2);
  margin: 0;
  font-size: var(--fs-small);
  color: var(--ink-soft);
}
.fye .tmon__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: var(--s9) var(--grid-gap);
}
.fye .tmon__item {
  display: flex;
  flex-direction: column;
  gap: var(--s4);
  margin: 0;
}
/* A quote is separated by a hairline above it, not by a card. */
.fye .tmon__item { padding-top: var(--s6); border-top: var(--hairline); }
.fye .tmon__stars { display: flex; gap: 2px; margin: 0; color: var(--sage); }
.fye .tmon__quote {
  margin: 0;
  font-size: var(--fs-body);
  color: var(--ink);
}
.fye .tmon__quote :where(p) { margin: 0; }
.fye .tmon__by { display: flex; flex-direction: column; gap: 2px; }
.fye .tmon__name {
  font-size: var(--fs-fine);
  font-weight: var(--fw-medium);
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
}
.fye .tmon__context { font-size: var(--fs-fine); color: var(--ink-soft); }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Testimonials" },
    { "type": "text", "id": "avg_rating", "label": "Average rating", "default": "4.9/5", "info": "Rendered as \"4.9/5 average\". Leave empty to hide." },
    {
      "type": "select", "id": "band", "label": "Background", "default": "ivory",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "White" },
        { "value": "mist",  "label": "Mist" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "context", "label": "What they bought" },
        { "type": "range", "id": "rating", "label": "Rating", "default": 5, "min": 0, "max": 5, "step": 1, "unit": "star" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
