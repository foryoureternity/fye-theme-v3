{%- comment -%}
  fye-testimonials — client quotes, rotating. 3 uses: index, page.about-us,
  page.about-us-v2.

  Setting IDs kept: `heading`, `enable_autoplay`,
  `autoplay_seconds`, `transition_ms`; `quote`, `name`, `context`, `rating`
  per block.

  HOW THE ROTATION WORKS, and why it is built this way
  The track is a real horizontal scroll container with scroll-snap, three
  quotes wide on desktop, two at 900px, one at 560px. That means it works
  before — and without — JavaScript: swipe on touch, trackpad-scroll on
  desktop, tab through the quotes on a keyboard. The JS in fye-ui.js only adds
  the arrows and the timer, so a JS failure costs the automation, not the
  content.

  The rotator (see the Rotators note in fye-ui.js) pauses on hover, pauses on
  keyboard focus inside it, pauses in a hidden tab, stops for good once the
  reader touches an arrow, and does not autoplay at all under
  prefers-reduced-motion. `transition_ms` feeds the CSS scroll duration where
  the browser honours it; browsers that do not simply use their own smooth
  scroll, which is why it is not exposed as a fine-grained control.

  Advancing scrolls by a whole visible page, so desktop moves three quotes at a
  time and mobile moves one. Six quotes is two desktop pages.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'ivory'
  assign secs = s.autoplay_seconds | default: 5.5
  assign ms = s.transition_ms | default: 500
  assign show_arrows = false
  if section.blocks.size > 3
    assign show_arrows = true
  endif
-%}

<section class="tmon band band--{{ band }}" data-screen-label="Testimonials">
  <div class="wrap">
    <div class="tmon__head">
      <div class="tmon__head-words">
        {%- if s.heading != blank -%}
          <h2 class="tmon__heading">{{ s.heading }}</h2>
        {%- endif -%}
      </div>
    </div>

    <div
      class="tmon__rot"
      {%- if s.enable_autoplay %} data-fye-rotate="{{ secs }}"{% else %} data-fye-rotate=""{% endif %}
      style="--tmon-scroll: {{ ms }}ms;">

      <div class="tmon__track" data-fye-rotate-track tabindex="0" role="group" aria-label="{{ s.heading | default: 'Testimonials' | escape }}">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <figure class="tmon__item" {{ block.shopify_attributes }}>
            {%- if b.rating > 0 -%}
              <p class="tmon__stars">
                {%- for i in (1..b.rating) -%}
                  {%- render 'icon', name: 'star', class: 'icon--sm' -%}
                {%- endfor -%}
                <span class="visually-hidden">{{ b.rating }} out of 5</span>
              </p>
            {%- endif -%}

            {%- if b.quote != blank -%}
              <blockquote class="tmon__quote">{{ b.quote }}</blockquote>
            {%- endif -%}

            {%- if b.name != blank or b.context != blank -%}
              <figcaption class="tmon__by">
                {%- if b.name != blank -%}
                  <span class="tmon__name">{{ b.name }}</span>
                {%- endif -%}
                {%- if b.context != blank -%}
                  <span class="tmon__context">{{ b.context }}</span>
                {%- endif -%}
              </figcaption>
            {%- endif -%}
          </figure>
        {%- endfor -%}
      </div>

      {%- if show_arrows -%}
        <div class="tmon__nav">
          <button type="button" class="tmon__arrow" data-fye-rotate-prev aria-label="Previous testimonials">
            {%- render 'icon', name: 'arrow-left', class: 'icon--sm' -%}
          </button>
          <button type="button" class="tmon__arrow" data-fye-rotate-next aria-label="Next testimonials">
            {%- render 'icon', name: 'arrow-right', class: 'icon--sm' -%}
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
/* Centred, like every other section header on the page. It was left-aligned
   with the rating pushed to the right, which read as a different site. */
.fye .tmon__head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--s3);
  margin-bottom: var(--s9);
  text-align: center;
}
.fye .tmon__head-words { display: flex; flex-direction: column; align-items: center; gap: var(--s3); }


.fye .tmon__rot { position: relative; }

/* A real scroll container: the rotation works without JS, and the snap points
   keep a part-scrolled page from settling between two quotes. */
.fye .tmon__track {
  display: flex;
  gap: var(--grid-gap);
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  scroll-timeline-name: none;
  /* transition_ms, where the browser honours a scroll duration. */
  transition-duration: var(--tmon-scroll, 500ms);
  /* No visible scrollbar — the arrows and the snap edges carry the affordance. */
  scrollbar-width: none;
  -ms-overflow-style: none;
  padding-bottom: 2px;   /* room for the focus ring, not decoration */
}
.fye .tmon__track::-webkit-scrollbar { display: none; }

/* Three up, minus the two gaps. 2 up at 900, 1 at 560 — set on the item, so
   the track needs no media query of its own. */
.fye .tmon__item {
  flex: 0 0 calc((100% - (2 * var(--grid-gap))) / 3);
  scroll-snap-align: start;
  display: flex;
  flex-direction: column;
  gap: var(--s4);
  margin: 0;
  padding-top: var(--s6);
  border-top: var(--hairline);
}

/* Filled, not outlined. The icon snippet draws a stroked star, so the fill is
   forced here — and on the descendants, because a fill="none" presentation
   attribute on the inner path is not overridden by a rule aimed at the <svg>. */
.fye .tmon__stars { display: flex; gap: 2px; margin: 0; color: var(--sage); }
.fye .tmon__stars :where(svg, svg *) { fill: currentColor; stroke: none; }
.fye .tmon__quote { margin: 0; font-size: var(--fs-body); color: var(--ink); }
.fye .tmon__quote :where(p) { margin: 0; }
.fye .tmon__by { display: flex; flex-direction: column; gap: 2px; margin-top: auto; }
.fye .tmon__name {
  font-size: var(--fs-fine);
  font-weight: var(--fw-medium);
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
}
.fye .tmon__context { font-size: var(--fs-fine); color: var(--ink-soft); }

/* Arrows sit with the heading on desktop, under the track on mobile. */
.fye .tmon__nav {
  position: absolute;
  top: calc(-1 * var(--s9));
  inset-inline-end: 0;
  display: flex;
  gap: var(--s2);
  transform: translateY(-100%);
}
.fye .tmon__arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  padding: 0;
  border: var(--hairline);
  background: transparent;
  color: var(--ink);
  transition: border-color var(--dur) var(--ease), color var(--dur) var(--ease);
}
.fye .tmon__arrow:hover { border-color: var(--sage); color: var(--sage); }

@media (max-width: 900px) {
  .fye .tmon__item { flex-basis: calc((100% - var(--grid-gap)) / 2); }
}

@media (max-width: 560px) {
  .fye .tmon__item { flex-basis: 100%; }
  .fye .tmon__head { margin-bottom: var(--s7); }
  .fye .tmon__nav {
    position: static;
    transform: none;
    justify-content: center;
    margin-top: var(--s6);
  }
}

@media (prefers-reduced-motion: reduce) {
  .fye .tmon__track { scroll-behavior: auto; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Testimonials" },
    { "type": "header", "content": "Rotation" },
    { "type": "checkbox", "id": "enable_autoplay", "label": "Rotate automatically", "default": true, "info": "Pauses on hover and for keyboard users, and stops once a visitor uses the arrows." },
    { "type": "range", "id": "autoplay_seconds", "label": "Seconds per page", "default": 5.5, "min": 3, "max": 12, "step": 0.5, "unit": "sec" },
    { "type": "range", "id": "transition_ms", "label": "Transition", "default": 500, "min": 200, "max": 1200, "step": 50, "unit": "ms" },
    { "type": "header", "content": "Background" },
    {
      "type": "select", "id": "band", "label": "Background", "default": "ivory",
      "options": [
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "White" },
        { "value": "mist",  "label": "Mist" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "richtext", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "context", "label": "What they bought" },
        { "type": "range", "id": "rating", "label": "Rating", "default": 5, "min": 0, "max": 5, "step": 1, "unit": "/5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [{ "type": "testimonial" }, { "type": "testimonial" }, { "type": "testimonial" }]
    }
  ]
}
{% endschema %}
