{%- comment -%}
  fye-xref — a pointer to the guide that covers this subject properly. 33 uses.

  A short cross-reference dropped mid-page: "Covered in more depth in The
  Engagement Ring Guide". Optionally with the guide's cover beside it, which is
  what makes it read as a signpost rather than another callout.

  Setting IDs kept exactly: `band`, `narrow`, `eyebrow`, `heading`, `body`,
  `link`, `link_label`, `cover`, `cover_alt`.

  No blocks — it points at one thing. If a page needs several, that is
  `fye-related` at the foot of the page, not three of these in the middle.

  With no cover set the text runs full width rather than leaving a hole, so the
  section is worth using either way.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'ivory'
  assign has_cover = false
  if s.cover != blank
    assign has_cover = true
  endif
-%}

<section class="xref band band--{{ band }} band--tight" data-screen-label="Guide pointer">
  <div class="wrap{% if s.narrow %} wrap--narrow{% endif %}">
    <div class="xref__box{% if has_cover %} xref__box--cover{% endif %}">
      {%- if has_cover -%}
        <div class="xref__cover">
          {{ s.cover | image_url: width: 480 | image_tag:
             loading: 'lazy', widths: '160,240,360,480', sizes: '150px',
             alt: s.cover_alt }}
        </div>
      {%- endif -%}

      <div class="xref__text">
        {%- if s.eyebrow != blank -%}
          <p class="eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}

        {%- if s.heading != blank -%}
          <h2 class="xref__heading">{{ s.heading }}</h2>
        {%- endif -%}

        {%- if s.body != blank -%}
          <div class="xref__body">{{ s.body }}</div>
        {%- endif -%}

        {%- if s.link != blank and s.link_label != blank -%}
          <a class="link xref__cta" href="{{ s.link }}">
            {{ s.link_label }}
            {%- render 'icon', name: 'arrow-right', class: 'icon--sm' -%}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
.fye .xref__box {
  display: flex;
  gap: var(--s7);
  align-items: center;
  padding: var(--s7);
  background: var(--white);
  border: var(--hairline);
}
.fye .band--white .xref__box { background: var(--ivory); border-color: transparent; }

.fye .xref__cover { flex: 0 0 150px; }
.fye .xref__cover :where(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }

.fye .xref__text { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s3); }
.fye .xref__heading { font-size: var(--fs-h4); }
.fye .xref__body { font-size: var(--fs-small); color: var(--ink-soft); }
.fye .xref__cta { margin-top: var(--s2); }
.fye .xref__cta .icon { transition: transform var(--dur) var(--ease); }
.fye .xref__cta:hover .icon { transform: translateX(3px); }

@media (max-width: 560px) {
  .fye .xref__box { flex-direction: column; align-items: flex-start; padding: var(--s5); }
  .fye .xref__cover { flex-basis: auto; max-width: 120px; }
}
@media (prefers-reduced-motion: reduce) {
  .fye .xref__cta:hover .icon { transform: none; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Guide pointer",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Covered in more depth" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "body", "label": "Text" },
    { "type": "text", "id": "link_label", "label": "Link text", "default": "Read the guide" },
    { "type": "url", "id": "link", "label": "Link" },
    { "type": "header", "content": "Cover" },
    { "type": "image_picker", "id": "cover", "label": "Cover image", "info": "Optional. The text runs full width without one." },
    { "type": "text", "id": "cover_alt", "label": "Cover description" },
    { "type": "header", "content": "Layout" },
    { "type": "checkbox", "id": "narrow", "label": "Narrow measure", "default": true },
    {
      "type": "select", "id": "band", "label": "Background", "default": "ivory",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "mist",  "label": "Mist" }
      ]
    }
  ],
  "presets": [{ "name": "Guide pointer" }]
}
{% endschema %}
