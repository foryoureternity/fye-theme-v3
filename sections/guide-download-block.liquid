{%- comment -%}
  guide-download-block — the six free guides, as covers with a download CTA.

  5 uses: index, article, blog, page.about-us, page.about-us-v2.

  Setting IDs kept: `heading`, `subtext`, `button_label`, `background`; `show`, `cover`, `title`, `klaviyo_form_id`, `file_url`,
  `blurb` per guide block.

  HOW THE CTA RESOLVES — this matters, it is the section's whole job
  Each guide is gated behind a Klaviyo form, and the live content mixes two
  patterns:
    - most guides carry a `klaviyo_form_id` and no link — the button opens the
      popup for that form;
    - the ring-care guide carries a `file_url` to its own download page.
  So: a `file_url` wins and renders a real link. Otherwise, if there is a form
  ID, the button carries `data-fye-popup` with that ID for the popup script to
  pick up (build-state job 6 — the 12 popup sections consolidate into one, and
  they read this attribute). With neither, the guide renders as a cover and a
  blurb with no button, rather than a button that does nothing.

  `show` is an explicit per-guide switch — the live site uses it to hold guides
  back while covers are being made. A guide with `show` off is skipped
  entirely, so it stays in the block list without appearing.

  `background` is teal on the live site. On teal, `--ink-soft` resolves to
  `--on-dark-soft` (8.0:1) — see the band rules in fye-core.css — so the blurbs
  stay readable without a per-section colour.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.background | default: 'teal'
  unless band == 'teal' or band == 'ivory' or band == 'white' or band == 'mist' or band == 'sage'
    assign band = 'teal'
  endunless
  assign label = s.button_label | default: 'View guide'
-%}

<section class="guides band band--{{ band }}" data-screen-label="Guide downloads">
  <div class="wrap">
    <div class="sect-head">
      {%- if s.heading != blank -%}
        <h2 class="heading-flank">{{ s.heading }}</h2>
      {%- endif -%}
      {%- if s.subtext != blank -%}
        <div class="lead guides__subtext">{{ s.subtext }}</div>
      {%- endif -%}
    </div>

    <ul class="guides__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          unless b.show
            continue
          endunless
        -%}
        <li class="guides__item" {{ block.shopify_attributes }}>
          <div class="guides__cover">
            {%- if b.cover != blank -%}
              {{ b.cover | image_url: width: 600 | image_tag:
                 loading: 'lazy', widths: '240,360,480,600',
                 sizes: '(max-width: 560px) 60vw, (max-width: 900px) 30vw, 220px',
                 alt: b.title }}
            {%- else -%}
              <span class="guides__ph"></span>
            {%- endif -%}
          </div>

          <div class="guides__words">
            {%- if b.title != blank -%}
              <h3 class="guides__title">{{ b.title }}</h3>
            {%- endif -%}
            {%- if b.blurb != blank -%}
              <p class="guides__blurb">{{ b.blurb }}</p>
            {%- endif -%}

            {%- if b.file_url != blank -%}
              <a class="btn btn--outline btn--sm" href="{{ b.file_url }}">{{ label }}</a>
            {%- elsif b.klaviyo_form_id != blank -%}
              <button type="button" class="btn btn--outline btn--sm" data-fye-popup="{{ b.klaviyo_form_id }}">{{ label }}</button>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ul>

  </div>
</section>

{% stylesheet %}
.fye .guides__subtext :where(p) { margin: 0; }

/* SIX ACROSS IN ONE ROW, as live. A compact shelf of guides, not a
   catalogue: my 3 x 2 with large covers took three times the height for the
   same six items. */
.fye .guides__grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: var(--s6) var(--s5);
  list-style: none;
  margin: 0;
  padding: 0;
}
@media (max-width: 1100px) {
  .fye .guides__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
}
@media (max-width: 560px) {
  .fye .guides__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
.fye .guides__item {
  display: flex;
  flex-direction: column;
  gap: var(--s4);
  margin: 0;
}
/* Covers are portrait artwork; a fixed ratio keeps six unequal files aligned.
   No max-width now — the column is the constraint, six to a row. */
.fye .guides__cover { width: 100%; }
.fye .guides__cover :where(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; }
.fye .guides__ph { display: block; aspect-ratio: 3 / 4; background: var(--ivory); opacity: 0.25; }

/* Centred under the cover: six covers in a row read as a shelf, and a
   left-aligned label under centred artwork looks like a mistake at this size. */
.fye .guides__words {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  gap: var(--s3);
}
/* Smaller at six across: the title is a label on a shelf, not a heading. */
.fye .guides__title { font-size: var(--fs-fine); letter-spacing: var(--tr-h2); }
.fye .guides__blurb {
  margin: 0;
  font-size: var(--fs-fine);
  color: var(--ink-soft);
}
.fye .guides__words .btn { margin-top: var(--s1); }

/* The blurb is the first thing to go when six share a row — it is a nice-to-
   have and the title plus cover already say which guide this is. */
@media (min-width: 1101px) {
  .fye .guides__blurb { display: none; }
}

.fye .row--center { justify-content: center; }
{% endstylesheet %}

{% schema %}
{
  "name": "Guide downloads",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Free expert guides" },
    { "type": "richtext", "id": "subtext", "label": "Supporting text" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "View guide", "info": "Used on every guide." },
    {
      "type": "select", "id": "background", "label": "Background", "default": "teal",
      "options": [
        { "value": "teal",  "label": "Teal" },
        { "value": "sage",  "label": "Sage" },
        { "value": "ivory", "label": "Ivory" },
        { "value": "white", "label": "White" },
        { "value": "mist",  "label": "Mist" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guide",
      "settings": [
        { "type": "checkbox", "id": "show", "label": "Show this guide", "default": true },
        { "type": "image_picker", "id": "cover", "label": "Cover" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "blurb", "label": "Blurb" },
        { "type": "text", "id": "klaviyo_form_id", "label": "Klaviyo form ID", "info": "The button opens this form's popup." },
        { "type": "url", "id": "file_url", "label": "Direct link", "info": "Used instead of the popup when set — e.g. a download page." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Guide downloads",
      "blocks": [{ "type": "guide" }, { "type": "guide" }, { "type": "guide" }]
    }
  ]
}
{% endschema %}
