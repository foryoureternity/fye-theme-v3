{%- comment -%}
  header-bottom — the ONE live header. Type name kept from the old theme.

  ----------------------------------------------------------------------------
  MEASURED FROM THE LIVE SITE, 27/08/2026 (2x screenshot, 1470px viewport).
  Every number below was sampled, not estimated. Do not "tidy" them into
  tokens without re-measuring — this is chrome, and chrome is pixel work.

    announcement strip   47.5px   #EEF2EE           (separate section)
    main row            145.5px   #FFFFFF
    rule                    1px   #C8CDC7  (sage grey, NOT a teal hairline)
    nav band               49px   #F2F1E8  (ivory, NO rule beneath)

    padding-inline         32px
    contact link           14px / 600 / +0.09em, icon 18px, 10px gap
    gap between contacts   30px
    logo                   96px tall, centred
    CTA                 217x44px, 1px teal border, 17px / 300 / +0.02em
    utility icons        41x44px boxes, 22px glyphs, -12px optical inset
    nav item               15px / 600 / +0.10em, 32px gaps, chevron 13px
    active nav item        sage (HOME is sage on the homepage)

  Nav is built from section BLOCKS (mega / drop / base), not a linklist —
  that is how the live theme works, and why a linklist version fell back to
  Shopify's default "Home / Catalog".
{%- endcomment -%}

<header class="hdr">
  <div class="hdr__main">
    <div class="hdr__main-in">
      <button class="hdr__icon hdr__burger" type="button" aria-label="{{ 'general.menu' | t }}" aria-expanded="false" data-fye-drawer-open>
        {% render 'icon', name: 'menu' %}
      </button>

      <div class="hdr__contact">
        {%- if section.settings.phone != blank -%}
          <a class="hdr__contact-link" href="tel:{{ section.settings.phone | remove: ' ' }}">
            {% render 'icon', name: 'phone', size: 18 %}<span>{{ section.settings.phone }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <a class="hdr__contact-link" href="mailto:{{ section.settings.email }}">
            {% render 'icon', name: 'mail', size: 18 %}<span>Email</span>
          </a>
        {%- endif -%}
        {%- if section.settings.booking_url != blank -%}
          <a class="hdr__contact-link" href="{{ section.settings.booking_url }}">
            {% render 'icon', name: 'calendar', size: 18 %}<span>Book appointment</span>
          </a>
        {%- endif -%}
      </div>

      {%- liquid
        assign logo_d = section.settings.logo_url
        assign logo_m = section.settings.logo_mb_url | default: logo_d
      -%}
      <a class="hdr__logo" href="{{ routes.root_url }}">
        {%- comment -%}
          Output directly, NO image_url filter: that filter only handles
          rasters, and handing it the SVG wordmark returned nothing, which is
          why this fell through to the text fallback. width/height are the real
          intrinsic sizes so the header does not reflow as they load.
        {%- endcomment -%}
        {%- if logo_d != blank -%}
          <img class="hdr__logo-img hdr__logo-img--d" src="{{ logo_d }}" alt="{{ shop.name | escape }}" width="471" height="264" fetchpriority="high">
          <img class="hdr__logo-img hdr__logo-img--m" src="{{ logo_m }}" alt="{{ shop.name | escape }}" width="571" height="320" fetchpriority="high">
        {%- elsif settings.logo != blank -%}
          {{ settings.logo | image_url: width: 800 | image_tag: alt: shop.name, loading: 'eager' }}
        {%- else -%}
          <span class="hdr__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <div class="hdr__right">
        {%- if section.settings.cta_label != blank -%}
          <a class="hdr__cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        <div class="hdr__icons">
          <a class="hdr__icon" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</a>
          <a class="hdr__icon" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'account' %}</a>
          <a class="hdr__icon" href="/a/wishlist" aria-label="{{ 'general.wishlist' | t }}">{% render 'icon', name: 'heart' %}</a>
          <a class="hdr__icon" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">
            {% render 'icon', name: 'bag' %}
            {%- if cart.item_count > 0 -%}<span class="hdr__count">{{ cart.item_count }}</span>{%- endif -%}
          </a>
        </div>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <nav class="hdr__nav" aria-label="Main">
      <ul class="hdr__nav-list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign is_active = false
            if block.settings.url == request.path
              assign is_active = true
            endif
            assign sub = linklists[block.settings.menu]
          -%}
          <li class="hdr__nav-item{% if block.type == 'mega' %} has-mega{% endif %}" {{ block.shopify_attributes }}>
            {%- comment -%}
              The anchor is emitted as one balanced block. Twice now a slice
              anchored on "if block.type == 'mega'" has matched the CHEVRON
              inside this anchor rather than the panel below it, taking the
              </a> with it and nesting the whole panel inside the link.
            {%- endcomment -%}
            <a class="hdr__nav-link{% if is_active %} is-active{% endif %}" href="{{ block.settings.url | default: '#' }}">
              <span>{{ block.settings.title }}</span>
              {%- if block.type == 'mega' -%}{% render 'icon', name: 'chevron-down', size: 13 %}{%- endif -%}
            </a>

            {%- if block.type == 'mega' -%}
              {%- liquid
                assign b = block.settings
                assign edu = linklists[b.edu_menu]
                assign jew = linklists[b.jewel_menu]
                assign tabbed = false
                if b.tab2_label != blank
                  assign tabbed = true
                endif
              -%}
              <div class="mega">
                <div class="mega__in">

                  <div class="mm__main">
                    {%- comment -%}
                      The radios MUST be direct children of .mm__main, ahead of
                      the row head and both tab bodies: every rule that reveals
                      a body or marks the active tab is a sibling selector, and
                      a sibling selector cannot climb out of .mm__tab-bar. This
                      cost a full panel-blank bug on 28/08. The labels stay in
                      the bar — <label for> works across the whole document.
                    {%- endcomment -%}
                    {%- if tabbed -%}
                      <input class="mm__tab-in" type="radio" name="mmtab-{{ block.id }}" id="mmtab-{{ block.id }}-1" checked>
                      <input class="mm__tab-in" type="radio" name="mmtab-{{ block.id }}" id="mmtab-{{ block.id }}-2">
                    {%- endif -%}
                    <div class="mm__row-head mm__row-head--major">
                      {%- if tabbed -%}
                        <div class="mm__tab-bar">
                          <label class="mm__tab" for="mmtab-{{ block.id }}-1">{{ b.tab1_label | default: 'Diamonds' }}</label>
                          <label class="mm__tab" for="mmtab-{{ block.id }}-2">{{ b.tab2_label }}</label>
                        </div>
                      {%- else -%}
                        <h2 class="mm__zone-title">{{ b.zone1_title | default: 'Pre-Designed Rings' }}</h2>
                      {%- endif -%}
                      {%- if b.zone1_all_url != blank -%}
                        <a class="mm__viewall" href="{{ b.zone1_all_url }}">
                          {{ b.zone1_all_label | default: 'View all' }}
                          {% render 'icon', name: 'arrow-right', size: 16 %}
                        </a>
                      {%- endif -%}
                    </div>

                    {%- comment -%}
                      Tab 1 / the untabbed panel. Column order differs per
                      panel — wedding leads with shapes, the others lead with
                      their menu columns — hence shapes_first.
                    {%- endcomment -%}
                    <div class="mm__tab-body mm__tab-body--1">
                      <div class="mm__cols">
                        {%- if b.shapes_first -%}
                          {%- render 'mm-shapes', set: b.shape_set, label: b.shape_label -%}
                        {%- endif -%}

                        {%- for child in sub.links -%}
                          {%- liquid
                            assign lower = child.title | downcase
                            assign as_dots = false
                            if lower contains 'metal'
                              assign as_dots = true
                            endif
                          -%}
                          <div class="mm__col">
                            <h3 class="mm__label">{{ child.title }}</h3>
                            <ul class="mm__list{% if as_dots %} mm__list--dots{% endif %}">
                              {%- for gc in child.links -%}
                                {%- liquid
                                  assign m = gc.title | downcase
                                  assign hex = '#C8CDC7'
                                  if m contains 'yellow'
                                    assign hex = '#E8CE8B'
                                  elsif m contains 'rose'
                                    assign hex = '#DFAE9B'
                                  elsif m contains 'white'
                                    assign hex = '#E4E4E2'
                                  elsif m contains 'platinum'
                                    assign hex = '#C9CBCC'
                                  endif
                                -%}
                                <li>
                                  <a href="{{ gc.url }}">
                                    {%- if as_dots -%}<span class="mm__dot mm__dot--pale" style="background:{{ hex }}"></span>{%- endif -%}
                                    <span>{{ gc.title }}</span>
                                  </a>
                                </li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endfor -%}

                        {%- unless b.shapes_first -%}
                          {%- render 'mm-shapes', set: b.shape_set, label: b.shape_label -%}
                        {%- endunless -%}
                      </div>

                      {%- if b.show_cuts -%}
                        {%- render 'mm-cuts', label: b.cuts_label -%}
                      {%- endif -%}

                      {%- render 'mm-stones',
                          set: b.stone_set,
                          label: b.stone_label,
                          all_url: b.stone_all_url,
                          all_label: b.stone_all_label -%}
                    </div>

                    {%- if tabbed -%}
                      <div class="mm__tab-body mm__tab-body--2">
                        {%- assign t2 = linklists[b.tab2_menu] -%}
                        <div class="mm__cols">
                          {%- for child in t2.links -%}
                            <div class="mm__col">
                              <h3 class="mm__label">{{ child.title }}</h3>
                              <ul class="mm__list">
                                {%- for gc in child.links -%}
                                  <li><a href="{{ gc.url }}">{{ gc.title }}</a></li>
                                {%- endfor -%}
                              </ul>
                            </div>
                          {%- endfor -%}
                        </div>
                        {%- render 'mm-stones',
                            set: b.tab2_stone_set,
                            label: b.tab2_stone_label,
                            all_url: b.tab2_stone_all_url,
                            all_label: b.tab2_stone_all_label -%}
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="mm__side">
                    <div class="mm__row-head mm__row-head--major">
                      <h2 class="mm__zone-title">{{ b.side_title | default: 'The Guide' }}</h2>
                    </div>

                    {%- render 'mm-guide-card',
                        cover: b.guide1_cover, title: b.guide1_title,
                        blurb: b.guide1_blurb, link: b.guide1_link -%}
                    {%- render 'mm-guide-card',
                        cover: b.guide2_cover, title: b.guide2_title,
                        blurb: b.guide2_blurb, link: b.guide2_link -%}

                    {%- if edu.links.size > 0 or jew.links.size > 0 -%}
                      <div class="mm__side-cols">
                        {%- if edu.links.size > 0 -%}
                          <div class="mm__col">
                            <h3 class="mm__label">{{ b.edu_label | default: 'Diamond Education' }}</h3>
                            <ul class="mm__list mm__list--caps">
                              {%- for link in edu.links -%}
                                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endif -%}
                        {%- if jew.links.size > 0 -%}
                          <div class="mm__col">
                            <h3 class="mm__label">{{ b.jewel_label | default: 'Jewellery Guide' }}</h3>
                            <ul class="mm__list mm__list--caps">
                              {%- for link in jew.links -%}
                                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                              {%- endfor -%}
                            </ul>
                          </div>
                        {%- endif -%}
                      </div>
                    {%- endif -%}

                    {%- if b.side_note != blank -%}
                      <p class="mm__note">{{ b.side_note }}</p>
                    {%- endif -%}
                  </div>

                </div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</header>

<div class="drawer" data-fye-drawer>
  <div class="drawer__panel">
    <button class="drawer__close" type="button" aria-label="{{ 'general.close' | t }}" data-fye-drawer-close>
      {% render 'icon', name: 'close' %}
    </button>
    <ul class="drawer__list">
      {%- for block in section.blocks -%}
        {%- assign dsub = linklists[block.settings.menu] -%}
        {%- if block.type == 'mega' and dsub.links.size > 0 -%}
          {%- comment -%}
            Native <details>, same reasoning as the footer: keyboard operable,
            announced properly, and it opens with no JavaScript. Closed by
            default here because the drawer is already a deliberate action —
            unlike the footer, nothing is hidden until the user opens it.
          {%- endcomment -%}
          <li>
            <details class="drawer__acc">
              <summary>
                <span>{{ block.settings.title }}</span>
                {% render 'icon', name: 'chevron-down', size: 16 %}
              </summary>
              <ul class="drawer__sub">
                {%- if block.settings.url != blank -%}
                  <li><a href="{{ block.settings.url }}">All {{ block.settings.title | downcase }}</a></li>
                {%- endif -%}
                {%- for child in dsub.links -%}
                  <li><a href="{{ child.url }}">{{ child.title }}</a></li>
                  {%- for gc in child.links -%}
                    <li class="drawer__sub-deep"><a href="{{ gc.url }}">{{ gc.title }}</a></li>
                  {%- endfor -%}
                {%- endfor -%}
              </ul>
            </details>
          </li>
        {%- else -%}
          <li><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.title }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    </ul>
    <div class="drawer__contact">
      {%- if section.settings.phone != blank -%}
        <a href="tel:{{ section.settings.phone | remove: ' ' }}">{% render 'icon', name: 'phone', size: 18 %}<span>{{ section.settings.phone }}</span></a>
      {%- endif -%}
      {%- if section.settings.whatsapp_url != blank -%}
        <a href="{{ section.settings.whatsapp_url }}">{% render 'icon', name: 'phone', size: 18 %}<span>WhatsApp</span></a>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <a href="mailto:{{ section.settings.email }}">{% render 'icon', name: 'mail', size: 18 %}<span>Email</span></a>
      {%- endif -%}
      {%- if section.settings.booking_url != blank -%}
        <a class="btn btn--block" href="{{ section.settings.booking_url }}">Book appointment</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
/* Header is CHROME, not a content band: its padding is deliberately its own
   and does NOT come from --sect-y. Full width, no max-width container. */
/* position + z-index are load-bearing for the mega panels: without a
   positioned ancestor an absolute panel resolves against the VIEWPORT, so
   top: 100% put it one screen-height down the page, below the hero. */
.fye .hdr { background: var(--white); position: relative; z-index: 40; }

.fye .hdr__main {
  padding-inline: var(--s7);            /* 32px, measured */
  border-bottom: 1px solid var(--sage-grey);
}
.fye .hdr__main-in {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--s6);
  min-height: 145px;                    /* measured */
}

.fye .hdr__contact { display: flex; align-items: center; gap: 30px; }
.fye .hdr__contact-link {
  display: inline-flex; align-items: center; gap: 10px;
  color: var(--ink);
  font-size: 14px;
  font-weight: var(--fw-semi);
  letter-spacing: 0.09em;
  line-height: 1;
  text-transform: uppercase;
  white-space: nowrap;
}
.fye .hdr__contact-link:hover { color: var(--sage); }
.fye .hdr__contact-link .icon { width: 18px; height: 18px; }

.fye .hdr__logo { justify-self: center; }
.fye .hdr__logo img { display: block; height: 96px; width: auto; }
.fye .hdr__logo-text {
  font-family: var(--font-display);
  font-size: 26px;
  letter-spacing: var(--tr-h2);
  text-transform: uppercase;
}

.fye .hdr__right { justify-self: end; display: flex; align-items: center; gap: var(--s4); }
.fye .hdr__cta {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 44px;
  padding: 0 var(--s6);
  border: 1px solid var(--teal);
  color: var(--ink);
  font-size: 17px;
  font-weight: var(--fw-light);
  letter-spacing: 0.02em;
  line-height: 1;
  text-transform: uppercase;
  white-space: nowrap;
  transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
}
.fye .hdr__cta:hover { background: var(--teal); color: var(--ivory); }

/* -12px pulls the icon row's optical padding back to the 32px page edge. */
.fye .hdr__icons { display: flex; align-items: center; margin-right: -12px; }
.fye .hdr__icon {
  display: inline-flex; align-items: center; justify-content: center;
  position: relative;
  width: 41px; height: 44px;
  border: 0; background: none; padding: 0;
  color: var(--ink);
}
.fye .hdr__icon:hover { color: var(--sage); }
.fye .hdr__icon .icon { width: 22px; height: 22px; }
.fye .hdr__count {
  position: absolute; top: 3px; right: 2px;
  min-width: 18px; height: 18px;
  display: grid; place-items: center;
  padding: 0 4px;
  background: var(--teal); color: var(--ivory);
  font-size: 11px; font-weight: var(--fw-medium); line-height: 1;
}

.fye .hdr__burger { display: none; justify-self: start; }

/* Nav band — ivory, 49px, centred, NO rule beneath (content starts flush). */
/* The panel's vertical origin. top: 100% must mean "below the nav band", not
   "below the whole header" — the logo row above it is 145px tall. */
.fye .hdr__nav { background: var(--ivory); position: relative; }
.fye .hdr__nav-list {
  display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
  gap: var(--s5);
  min-height: 49px;
  margin: 0; padding-inline: var(--s7); list-style: none;
}
.fye .hdr__nav-item { margin: 0; position: relative; }
.fye .hdr__nav-link {
  display: inline-flex; align-items: center; gap: var(--s2);
  padding-block: var(--s3);
  color: var(--ink);
  /* 13px / 0.08em measured off live. At 15px and 0.10em the eleven menu
     items could not fit one row and the last two wrapped. */
  font-size: 13px;
  font-weight: var(--fw-semi);
  letter-spacing: 0.08em;
  line-height: 1;
  text-transform: uppercase;
  white-space: nowrap;
}
.fye .hdr__nav-link:hover,
.fye .hdr__nav-link.is-active { color: var(--sage); }
.fye .hdr__nav-link .icon { width: 13px; height: 13px; stroke-width: 1.6; }

/* Mega panel — full-bleed ivory sheet, opens on hover and on keyboard focus. */
.fye .mega {
  position: absolute; left: 50%; top: 100%;
  transform: translateX(-50%);
  min-width: 640px;
  background: var(--white);
  border: 1px solid var(--sage-grey);
  border-top: 0;
  padding: var(--s8);
  display: none;
  z-index: 50;
}
.fye .hdr__nav-item:hover .mega,
.fye .hdr__nav-item:focus-within .mega { display: block; }
.fye .mega__in { display: flex; gap: var(--s10); }
.fye .mega__col { min-width: 180px; }
.fye .mega__head {
  display: block;
  margin-bottom: var(--s4);
  font-family: var(--font-display);
  font-size: 15px;
  letter-spacing: var(--tr-h2);
  text-transform: uppercase;
}
.fye .mega__list { margin: 0; padding: 0; list-style: none; }
.fye .mega__list li { margin-bottom: var(--s3); }
.fye .mega__list a { font-size: 16px; font-weight: var(--fw-light); }

/* Mobile drawer */
.fye .drawer { position: fixed; inset: 0; z-index: 60; background: var(--scrim); display: none; }
.fye .drawer.is-open { display: block; }
.fye .drawer__panel {
  position: absolute; inset-block: 0; inset-inline-start: 0;
  width: min(88vw, 380px);
  background: var(--white);
  padding: var(--s6);
  overflow-y: auto;
}
.fye .drawer__close {
  position: absolute; top: var(--s3); right: var(--s3);
  width: 44px; height: 44px;
  border: 0; background: none; color: var(--ink);
  display: inline-flex; align-items: center; justify-content: center;
}
.fye .drawer__list { margin: var(--s10) 0 var(--s7); padding: 0; list-style: none; }
.fye .drawer__list li { border-bottom: var(--hairline); padding: var(--s3) 0; margin: 0; }
.fye .drawer__list a {
  font-size: 15px; font-weight: var(--fw-semi);
  letter-spacing: 0.09em; text-transform: uppercase;
}
.fye .drawer__contact { display: flex; flex-direction: column; gap: var(--s4); }
.fye .drawer__contact a {
  display: inline-flex; align-items: center; gap: 10px;
  font-size: 14px; font-weight: var(--fw-semi);
  letter-spacing: 0.09em; text-transform: uppercase;
}
.fye .drawer__contact .btn { text-transform: uppercase; }

/* Narrow desktop: drop the contact labels before dropping the whole row. */
@media (max-width: 1280px) {
  .fye .hdr__contact { gap: var(--s5); }
  .fye .hdr__contact-link span { display: none; }
  .fye .hdr__nav-list { gap: var(--s4); }
  .fye .hdr__nav-link { font-size: 12px; letter-spacing: 0.06em; }
}

@media (max-width: 900px) {
  .fye .hdr__main { padding-inline: var(--pad-x); }
  /* 1fr auto 1fr, not auto 1fr auto: with unequal side tracks the middle track
     is not centred on the row, so a centred logo inside it still sits off to
     one side by half the difference between burger and icon row. */
  .fye .hdr__main-in { grid-template-columns: 1fr auto 1fr; min-height: 72px; gap: var(--s3); }
  .fye .hdr__burger { display: inline-flex; }
  .fye .hdr__contact { display: none; }
  .fye .hdr__cta { display: none; }
  .fye .hdr__nav { display: none; }
  .fye .hdr__logo img { height: 46px; }
  .fye .hdr__icons { margin-right: -10px; }
  .fye .hdr__icon { width: 40px; }
}

/* Which logo shows. The img TYPE selector is load-bearing: the base rule
   .fye .hdr__logo img is (0,2,1), so a two-class override loses to it however
   late it appears — order only breaks ties. These are (0,3,1). */
.fye .hdr__logo img.hdr__logo-img--d { display: block; height: 96px; width: auto; }
.fye .hdr__logo img.hdr__logo-img--m { display: none; }

@media (max-width: 900px) {
  /* The mobile mark is 571x320 — a wide lockup — so it is capped by height to
     fit the 62px row. Raise if it reads small on a real phone. */
  .fye .hdr__logo img.hdr__logo-img--d { display: none; }
  /* 52px. The mark is a 571x320 lockup, so height drives a much smaller width
     than it would for a square monogram — at 40px it was ~71px wide and read
     as an afterthought beside the 22px icons. */
  .fye .hdr__logo img.hdr__logo-img--m { display: block; height: 52px; width: auto; }
}

/* ============================================================================
