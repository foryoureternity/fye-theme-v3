   Two zones on an ivory sheet: shop-by grids left, guide + education right,
   divided by a vertical hairline.
   ========================================================================== */

.fye .hdr__nav-item.has-mega { position: static; }
.fye .has-mega .mega {
  position: absolute;
  left: 0; right: 0; top: 100%;
  transform: none;
  min-width: 0;
  max-height: calc(100vh - 190px);
