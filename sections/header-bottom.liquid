{%- comment -%}
  header-bottom — rebuilt 26/08/2026 to match the LIVE site exactly.
  Reference: live foryoureternity.com header.

  Layout (desktop, full width):
    row 1  announcement bar (separate section)
    row 2  contact links (left) · script logo (centre) · guides button + icons (right)
    row 3  nav band on ivory, centred, with a fine accent rule beneath

  NOT sticky (live theme has sticky_header false).
  NO wishlist icon in the utility set? — live shows one, so it is included.

  TODO: nav items are section blocks so they stay editable. Mega dropdown
  contents still to be built — the chevron is present and the markup hook is
  there, but the panels come from the mega-menu port.
{%- endcomment -%}

<header class="hdr">
  <div class="hdr__main">
    <div class="hdr__main-in">
      <button class="hdr__burger" type="button" aria-label="{{ 'general.menu' | t }}" aria-expanded="false" data-fye-drawer-open>
        {% render 'icon', name: 'menu' %}
      </button>

      <div class="hdr__contact">
        {%- if section.settings.phone != blank -%}
          <a class="hdr__contact-link" href="tel:{{ section.settings.phone | remove: ' ' }}">
            {% render 'icon', name: 'phone', size: 18 %}<span>{{ section.settings.phone }}</span>
          </a>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <a class="hdr__contact-link" href="mailto:{{ section.settings.email }}">
            {% render 'icon', name: 'mail', size: 18 %}<span>Email</span>
          </a>
        {%- endif -%}
        {%- if section.settings.booking_url != blank -%}
          <a class="hdr__contact-link" href="{{ section.settings.booking_url }}">
            {% render 'icon', name: 'calendar', size: 18 %}<span>Book appointment</span>
          </a>
        {%- endif -%}
      </div>

      <a class="hdr__logo" href="{{ routes.root_url }}">
        {%- if settings.logo != blank -%}
          {{ settings.logo | image_url: width: 800 | image_tag: alt: shop.name, width: settings.logo_width, loading: 'eager' }}
        {%- else -%}
          <span class="hdr__logo-text">{{ shop.name }}</span>
        {%- endif -%}
      </a>

      <div class="hdr__right">
        {%- if section.settings.cta_label != blank -%}
          <a class="hdr__cta" href="{{ section.settings.cta_link | default: '#' }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
        <div class="hdr__icons">
          <a class="hdr__icon" href="{{ routes.search_url }}" aria-label="{{ 'general.search' | t }}">{% render 'icon', name: 'search' %}</a>
          <a class="hdr__icon" href="{{ routes.account_url }}" aria-label="{{ 'general.account' | t }}">{% render 'icon', name: 'account' %}</a>
          <a class="hdr__icon" href="/a/wishlist" aria-label="{{ 'general.wishlist' | t }}">{% render 'icon', name: 'heart' %}</a>
          <a class="hdr__icon" href="{{ routes.cart_url }}" aria-label="{{ 'general.cart' | t }}">
            {% render 'icon', name: 'bag' %}
            {%- if cart.item_count > 0 -%}<span class="hdr__count">{{ cart.item_count }}</span>{%- endif -%}
          </a>
        </div>
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <nav class="hdr__nav" aria-label="Main">
      <ul class="hdr__nav-list">
        {%- for block in section.blocks -%}
          {%- assign is_active = false -%}
          {%- if block.settings.url == request.path -%}{%- assign is_active = true -%}{%- endif -%}
          <li class="hdr__nav-item{% if block.type == 'mega' %} has-mega{% endif %}" {{ block.shopify_attributes }}>
            <a class="hdr__nav-link{% if is_active %} is-active{% endif %}" href="{{ block.settings.url | default: '#' }}">
              <span>{{ block.settings.title }}</span>
              {%- if block.type == 'mega' -%}{% render 'icon', name: 'chevron-down', size: 13 %}{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </nav>
  {%- endif -%}
</header>

<div class="drawer" data-fye-drawer>
  <div class="drawer__panel">
    <button class="drawer__close" type="button" aria-label="{{ 'general.close' | t }}" data-fye-drawer-close>
      {% render 'icon', name: 'close' %}
    </button>
    <ul class="drawer__list">
      {%- for block in section.blocks -%}
        <li><a href="{{ block.settings.url | default: '#' }}">{{ block.settings.title }}</a></li>
      {%- endfor -%}
    </ul>
    <div class="drawer__contact">
      {%- if section.settings.phone != blank -%}
        <a href="tel:{{ section.settings.phone | remove: ' ' }}">{% render 'icon', name: 'phone', size: 18 %}<span>{{ section.settings.phone }}</span></a>
      {%- endif -%}
      {%- if section.settings.whatsapp_url != blank -%}
        <a href="{{ section.settings.whatsapp_url }}">{% render 'icon', name: 'phone', size: 18 %}<span>WhatsApp</span></a>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <a href="mailto:{{ section.settings.email }}">{% render 'icon', name: 'mail', size: 18 %}<span>Email</span></a>
      {%- endif -%}
      {%- if section.settings.booking_url != blank -%}
        <a class="btn btn--block" href="{{ section.settings.booking_url }}">Book appointment</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
/* Chrome, not a content band: padding here is deliberate, not --sect-y. */
.fye .hdr { background: var(--white); }

.fye .hdr__main { padding: var(--s8) var(--s9); }
.fye .hdr__main-in {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: var(--s6);
}

.fye .hdr__contact { display: flex; align-items: center; gap: var(--s7); }
.fye .hdr__contact-link {
  display: inline-flex; align-items: center; gap: var(--s2);
  color: var(--ink);
  font-size: var(--fs-fine);
  font-weight: var(--fw-medium);
  letter-spacing: 0.12em;
  text-transform: uppercase;
  white-space: nowrap;
}
.fye .hdr__contact-link:hover { color: var(--sage); }

.fye .hdr__logo { justify-self: center; }
.fye .hdr__logo img { display: block; }
.fye .hdr__logo-text {
  font-family: var(--font-display);
  font-size: 26px;
  letter-spacing: var(--tr-h2);
  text-transform: uppercase;
}

.fye .hdr__right { justify-self: end; display: flex; align-items: center; gap: var(--s6); }
.fye .hdr__cta {
  display: inline-flex; align-items: center; justify-content: center;
  min-height: 48px;
  padding: 0 var(--s6);
  border: 1px solid var(--ink);
  color: var(--ink);
  font-size: var(--fs-fine);
  font-weight: var(--fw-regular);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  white-space: nowrap;
  transition: background var(--dur) var(--ease), color var(--dur) var(--ease);
}
.fye .hdr__cta:hover { background: var(--ink); color: var(--ivory); }

.fye .hdr__icons { display: flex; align-items: center; gap: var(--s1); }
.fye .hdr__icon {
  display: inline-flex; align-items: center; justify-content: center;
  position: relative;
  width: 44px; height: 44px;
  color: var(--ink);
}
.fye .hdr__icon:hover { color: var(--sage); }
.fye .hdr__count {
  position: absolute; top: 4px; right: 2px;
  min-width: 18px; height: 18px;
  display: grid; place-items: center;
  padding: 0 4px;
  background: var(--teal); color: var(--ivory);
  font-size: 10px; font-weight: var(--fw-medium);
}

.fye .hdr__burger { display: none; border: 0; background: none; color: var(--ink); width: 44px; height: 44px; align-items: center; justify-content: center; }

/* Nav band */
.fye .hdr__nav { background: var(--ivory); border-bottom: 2px solid var(--gold-rose); }
.fye .hdr__nav-list {
  display: flex; flex-wrap: wrap; justify-content: center; align-items: center;
  gap: var(--s7);
  margin: 0; padding: 0 var(--s9); list-style: none;
}
.fye .hdr__nav-item { margin: 0; }
.fye .hdr__nav-link {
  display: inline-flex; align-items: center; gap: var(--s1);
  padding: var(--s4) 0;
  color: var(--ink);
  font-size: 14px;
  font-weight: var(--fw-medium);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  white-space: nowrap;
}
.fye .hdr__nav-link:hover { color: var(--sage); }
.fye .hdr__nav-link.is-active { color: var(--sage); }

/* Mobile drawer */
.fye .drawer { position: fixed; inset: 0; z-index: 60; background: var(--scrim); display: none; }
.fye .drawer.is-open { display: block; }
.fye .drawer__panel {
  position: absolute; inset-block: 0; inset-inline-start: 0;
  width: min(88vw, 380px);
  background: var(--white);
  padding: var(--s6);
  overflow-y: auto;
}
.fye .drawer__close { position: absolute; top: var(--s3); right: var(--s3); width: 44px; height: 44px; border: 0; background: none; color: var(--ink); }
.fye .drawer__list { margin: var(--s9) 0 var(--s7); padding: 0; list-style: none; }
.fye .drawer__list li { border-bottom: var(--hairline); padding: var(--s3) 0; }
.fye .drawer__list a {
  font-size: 15px; font-weight: var(--fw-medium);
  letter-spacing: 0.1em; text-transform: uppercase;
}
.fye .drawer__contact { display: flex; flex-direction: column; gap: var(--s3); }
.fye .drawer__contact a { display: inline-flex; align-items: center; gap: var(--s2); font-size: var(--fs-small); }

@media (max-width: 1200px) {
  .fye .hdr__contact-link span { display: none; }
  .fye .hdr__contact { gap: var(--s4); }
}
@media (max-width: 900px) {
  .fye .hdr__main { padding: var(--s4) var(--pad-x); }
  .fye .hdr__burger { display: inline-flex; }
  .fye .hdr__contact { display: none; }
  .fye .hdr__cta { display: none; }
  .fye .hdr__nav { display: none; }
  .fye .hdr__main-in { grid-template-columns: auto 1fr auto; }
  .fye .hdr__logo img { max-width: 180px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "settings": [
    { "type": "text", "id": "phone", "label": "Phone", "default": "0208 178 6687" },
    { "type": "text", "id": "email", "label": "Email", "default": "hello@foryoureternity.com" },
    { "type": "url", "id": "booking_url", "label": "Booking link" },
    { "type": "url", "id": "whatsapp_url", "label": "WhatsApp link" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Downloadable guides" },
    { "type": "url", "id": "cta_link", "label": "Button link" }
  ],
  "blocks": [
    {
      "type": "base",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    },
    {
      "type": "mega",
      "name": "Link with dropdown",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "link_list", "id": "menu", "label": "Dropdown menu" }
      ]
    }
  ]
}
{% endschema %}
