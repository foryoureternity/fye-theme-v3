{%- comment -%}
  latest-news-EM — the homepage news band. 1 use: index.

  Setting IDs frozen: `heading`, `blog`, `bg_color`, plus the two label
  settings added on 27/08.

  GEOMETRY IS LIVE'S, read from the live theme rather than eyeballed:
    - grid 1fr 1fr, gap 25px, align-items: stretch
    - the right column's three cards set the height (flex: 1 each, gap 20px)
    - the lead photograph FILLS that height: height 100%, object-fit cover.
      No aspect-ratio — the two columns must agree, and this is the one that
      gives way.
    - the caption is absolutely positioned bottom-left INSIDE the photograph,
      max-width 280px, so it can never hang below it
    - thumbnails are a fixed 239px wide, full card height
    - titles are 16px / 1.4 / weight 400. Not 20px. At 20 every title wrapped
      to three lines and no amount of grid adjustment fixed the crowding.

  Do not reintroduce aspect ratios or negative margins here. Four passes were
  lost to that before I read live's numbers.
  SUPERSEDED 11/10/2026: the geometry above is the old live layout. The band
  was redrawn from the Claude Design homepage handoff (see the stylesheet
  note); the markup and the hidden link text are unchanged.

  28/09/2026 (W446): the "Read more" links carry the article title as
  visually hidden text instead of an aria-label. Crawlers and SEO tools read
  a link's text, not its aria-label, so Semrush counted every one as
  non-descriptive anchor text. The visible text is unchanged; screen readers
  now hear "Read more: <title>" from the link text itself.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.bg_color | default: 'ivory'
  assign the_blog = blogs[s.blog]
  assign arts = the_blog.articles
  assign lead = arts.first
  assign btn_label = s.btn_label | default: 'Read more'
  assign all_label = s.view_all_label | default: 'View more'
-%}

<div class="band band--{{ band }}">
  <div class="wrap">

    {%- if s.heading != blank -%}
      <div class="sect-head">
        <h2 class="heading-flank">{{ s.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if arts.size == 0 -%}
      <p class="lead">No articles yet.</p>
    {%- else -%}

      <div class="news__grid">

        <div class="news__lead">
          {%- liquid
            assign lead_alt = lead.title | strip_html | escape
            assign lead_excerpt = lead.excerpt_or_content | strip_html | truncatewords: 18, ''
          -%}
          <a class="news__lead-img" href="{{ lead.url }}" aria-label="{{ lead_alt }}">
            {%- if lead.image != blank -%}
              {{ lead.image | image_url: width: 1200 | image_tag:
                 loading: 'lazy', widths: '480,600,800,1000,1200',
                 sizes: '(max-width: 900px) 100vw, 50vw', alt: lead_alt }}
            {%- else -%}
              <span class="news__ph"></span>
            {%- endif -%}
          </a>
          <div class="news__lead-words">
            <a class="news__title" href="{{ lead.url }}">{{ lead.title }}</a>
            <p class="news__excerpt">{{ lead_excerpt }}</p>
            <a class="news__more" href="{{ lead.url }}">{{ btn_label }}<span class="visually-hidden">: {{ lead.title | strip_html | escape }}</span></a>
          </div>
        </div>

        <div class="news__list">
          {%- comment -%}
            limit: 4 with forloop.first skipped, not limit: 3 offset: 1 — same
            result, but it matches live's loop, so the two stay comparable.
          {%- endcomment -%}
          {%- for article in arts limit: 4 -%}
            {%- unless forloop.first -%}
              {%- liquid
                assign art_alt = article.title | strip_html | escape
                assign art_excerpt = article.excerpt_or_content | strip_html | truncatewords: 18, ''
              -%}
              <div class="news__row">
                <a class="news__row-img" href="{{ article.url }}" aria-label="{{ art_alt }}">
                  {%- if article.image != blank -%}
                    {{ article.image | image_url: width: 800 | image_tag:
                       loading: 'lazy', widths: '240,320,480,600,800',
                       sizes: '(max-width: 900px) 100vw, 239px', alt: art_alt }}
                  {%- else -%}
                    <span class="news__ph"></span>
                  {%- endif -%}
                </a>
                <div class="news__row-words">
                  <a class="news__title" href="{{ article.url }}">{{ article.title }}</a>
                  <p class="news__excerpt">{{ art_excerpt }}</p>
                  <a class="news__more" href="{{ article.url }}">{{ btn_label }}<span class="visually-hidden">: {{ art_alt }}</span></a>
                </div>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        </div>

      </div>

      {%- if the_blog.url != blank -%}
        <div class="news__foot">
          <a class="btn btn--outline" href="{{ the_blog.url }}">{{ all_label }}</a>
        </div>
      {%- endif -%}

    {%- endif -%}

  </div>
</div>

{% stylesheet %}
/* REDRAWN 11/10/2026 from the homepage design handoff. The lead story is now
   a card with the photograph and the words side by side (no caption box laid
   over the photo); the three others are hairline rows with a 4:3 thumbnail.
   Excerpts clamp to whole lines in CSS only: the full excerpt stays in the
   page for search. The 44px touch targets from 03/09/2026 are kept. */
.fye .news__grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s9) var(--grid-gap);
  align-items: stretch;
}

/* ---- lead ---------------------------------------------------------------- */
.fye .news__lead {
  flex: 1 1 340px;
  display: flex;
  flex-wrap: wrap;
  background: var(--white);
}
.fye .band--white .news__lead { background: var(--ivory); }
.fye .news__lead-img { flex: 1 1 220px; display: block; min-height: 280px; }
.fye .news__lead-img :where(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
.fye .news__lead-words {
  flex: 1 1 220px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: var(--s4);
  padding: var(--s7);
}
.fye .news__lead-words .news__title {
  font-family: var(--font-display);
  font-size: var(--fs-h4);
  line-height: var(--lh-heading);
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
.fye .news__lead-words .news__excerpt { -webkit-line-clamp: 3; }

/* ---- the three rows ------------------------------------------------------ */
.fye .news__list { flex: 1 1 340px; display: flex; flex-direction: column; }
.fye .news__row {
  display: flex;
  gap: var(--s6);
  padding: var(--s4) 0;
  border-top: var(--hairline);
}
.fye .news__row:last-child { border-bottom: var(--hairline); }
.fye .news__row-img { flex: none; width: clamp(96px, 28%, 180px); display: block; }
.fye .news__row-img :where(img) { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
.fye .news__row-words { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: var(--s2); }

/* ---- type ---------------------------------------------------------------- */
.fye .news__title {
  font-size: var(--fs-body);
  line-height: 1.3;
  font-weight: var(--fw-regular);
  color: var(--ink);
  text-decoration: none;
  text-wrap: pretty;
  transition: color var(--dur) var(--ease);
}
.fye .news__title:hover { color: var(--sage); }
.fye .news__excerpt {
  margin: 0;
  font-size: var(--fs-small);
  font-weight: var(--fw-light);
  line-height: var(--lh-body);
  color: var(--ink);
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
/* The underlined uppercase link of the design system, not a filled chip. */
.fye .news__more {
  font-size: var(--fs-fine);
  font-weight: var(--fw-medium);
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
  color: var(--ink);
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 6px;
  transition: color var(--dur) var(--ease);
}
.fye .news__more:hover { color: var(--sage); }
.fye .news__ph { display: block; width: 100%; height: 100%; min-height: 160px; background: var(--ivory); border: var(--hairline); }
.fye .news__foot { display: flex; justify-content: center; margin-top: var(--s9); }

@media (max-width: 560px) {
  .fye .news__lead-words { padding: var(--s6); }
  .fye .news__row { gap: var(--s4); }
}

/* ---------------------------------------------------------------------------
   TOUCH TARGETS, 03/09/2026. Found by fyeSmoke on the live homepage: the
   links and single-line titles measured under the 44px minimum, conventions
   section 7. flex + min-height, not padding, so a title that already wraps
   is left unchanged.
   --------------------------------------------------------------------------- */
.fye .news__more {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
}
.fye .news__title a,
.fye a.news__title {
  display: flex;
  align-items: center;
  min-height: 44px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Latest news",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest news" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Uses the 4 most recent posts: 1 featured + 3 compact." },
    { "type": "text", "id": "btn_label", "label": "Article button label", "default": "Read more" },
    { "type": "text", "id": "view_all_label", "label": "Closing button label", "default": "View more" },
    { "type": "header", "content": "Background" },
    {
      "type": "select", "id": "bg_color", "label": "Background", "default": "ivory",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Champagne ivory" },
        { "value": "mist",  "label": "Mist blue" }
      ]
    }
  ],
  "presets": [{ "name": "Latest news" }]
}
{% endschema %}
