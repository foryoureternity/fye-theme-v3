{%- comment -%}
  latest-news-EM — the homepage news band. 1 use: index.

  Setting IDs frozen: `heading`, `blog`, `bg_color`, plus the two label
  settings added on 27/08.

  GEOMETRY IS LIVE'S, read from the live theme rather than eyeballed:
    - grid 1fr 1fr, gap 25px, align-items: stretch
    - the right column's three cards set the height (flex: 1 each, gap 20px)
    - the lead photograph FILLS that height: height 100%, object-fit cover.
      No aspect-ratio — the two columns must agree, and this is the one that
      gives way.
    - the caption is absolutely positioned bottom-left INSIDE the photograph,
      max-width 280px, so it can never hang below it
    - thumbnails are a fixed 239px wide, full card height
    - titles are 16px / 1.4 / weight 400. Not 20px. At 20 every title wrapped
      to three lines and no amount of grid adjustment fixed the crowding.

  Do not reintroduce aspect ratios or negative margins here. Four passes were
  lost to that before I read live's numbers.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.bg_color | default: 'ivory'
  assign the_blog = blogs[s.blog]
  assign arts = the_blog.articles
  assign lead = arts.first
  assign btn_label = s.btn_label | default: 'Read more'
  assign all_label = s.view_all_label | default: 'View more'
-%}

<div class="band band--{{ band }}">
  <div class="wrap">

    {%- if s.heading != blank -%}
      <div class="sect-head">
        <h2 class="heading-flank">{{ s.heading }}</h2>
      </div>
    {%- endif -%}

    {%- if arts.size == 0 -%}
      <p class="lead">No articles yet.</p>
    {%- else -%}

      <div class="news__grid">

        <div class="news__lead">
          {%- liquid
            assign lead_alt = lead.title | strip_html | escape
            assign lead_excerpt = lead.excerpt_or_content | strip_html | truncatewords: 18, ''
          -%}
          <a class="news__lead-img" href="{{ lead.url }}" aria-label="{{ lead_alt }}">
            {%- if lead.image != blank -%}
              {{ lead.image | image_url: width: 1200 | image_tag:
                 loading: 'lazy', widths: '480,600,800,1000,1200',
                 sizes: '(max-width: 900px) 100vw, 50vw', alt: lead_alt }}
            {%- else -%}
              <span class="news__ph"></span>
            {%- endif -%}
          </a>
          <div class="news__lead-words">
            <a class="news__title" href="{{ lead.url }}">{{ lead.title }}</a>
            <p class="news__excerpt">{{ lead_excerpt }}</p>
            <a class="news__more" href="{{ lead.url }}" aria-label="{{ btn_label | escape }}: {{ lead.title | strip_html | escape }}">{{ btn_label }}</a>
          </div>
        </div>

        <div class="news__list">
          {%- comment -%}
            limit: 4 with forloop.first skipped, not limit: 3 offset: 1 — same
            result, but it matches live's loop, so the two stay comparable.
          {%- endcomment -%}
          {%- for article in arts limit: 4 -%}
            {%- unless forloop.first -%}
              {%- liquid
                assign art_alt = article.title | strip_html | escape
                assign art_excerpt = article.excerpt_or_content | strip_html | truncatewords: 18, ''
              -%}
              <div class="news__row">
                <a class="news__row-img" href="{{ article.url }}" aria-label="{{ art_alt }}">
                  {%- if article.image != blank -%}
                    {{ article.image | image_url: width: 800 | image_tag:
                       loading: 'lazy', widths: '240,320,480,600,800',
                       sizes: '(max-width: 900px) 100vw, 239px', alt: art_alt }}
                  {%- else -%}
                    <span class="news__ph"></span>
                  {%- endif -%}
                </a>
                <div class="news__row-words">
                  <a class="news__title" href="{{ article.url }}">{{ article.title }}</a>
                  <p class="news__excerpt">{{ art_excerpt }}</p>
                  <a class="news__more" href="{{ article.url }}" aria-label="{{ btn_label | escape }}: {{ article.title | strip_html | escape }}">{{ btn_label }}</a>
                </div>
              </div>
            {%- endunless -%}
          {%- endfor -%}
        </div>

      </div>

      {%- if the_blog.url != blank -%}
        <div class="news__foot">
          <a class="btn btn--outline" href="{{ the_blog.url }}">{{ all_label }}</a>
        </div>
      {%- endif -%}

    {%- endif -%}

  </div>
</div>

{% stylesheet %}
/* stretch, not start: the right column's height is the section's height and
   the photograph opposite fills it. */
.fye .news__grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 25px;
  align-items: stretch;
}

/* ---- lead ---------------------------------------------------------------- */

.fye .news__lead { position: relative; }
.fye .news__lead-img { display: block; height: 100%; }
.fye .news__lead-img :where(img) {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Absolutely positioned inside the photograph, bottom-left. This is live's
   device and the reason the caption never hangs below the image. */
.fye .news__lead-words {
  position: absolute;
  bottom: 0;
  left: 0;
  max-width: 280px;
  padding: 16px 18px;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6px;
  background: #fff;
}
.fye .band--white .news__lead-words { background: var(--ivory); }

/* ---- the three compact cards -------------------------------------------- */

.fye .news__list { display: flex; flex-direction: column; gap: 20px; height: 100%; }
/* flex: 1 — three equal thirds, which is what sets the band's height. */
.fye .news__row { display: flex; gap: 15px; flex: 1; }
.fye .news__row-img { flex: 0 0 239px; display: block; }
.fye .news__row-img :where(img) {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
}
.fye .news__row-words { flex: 1; display: flex; flex-direction: column; align-items: flex-start; gap: 6px; }

/* ---- type: live's 16px, not 20 ------------------------------------------- */

.fye .news__title {
  font-size: 16px;
  line-height: 1.4;
  font-weight: 400;
  letter-spacing: 0.01em;
  text-transform: none;
  color: var(--ink);
  text-decoration: none;
  text-wrap: pretty;
  transition: color var(--dur) var(--ease);
}
.fye .news__title:hover { color: var(--sage); }
.fye .news__excerpt {
  margin: 0;
  font-size: var(--fs-small);
  line-height: 1.55;
  color: var(--ink-soft);
  text-wrap: pretty;
}
.fye .news__more {
  display: inline-block;
  margin-top: 4px;
  padding: 6px 15px;
  background: var(--teal);
  color: var(--on-dark);
  font-size: 12px;
  font-weight: var(--fw-medium);
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
  text-decoration: none;
  transition: background var(--dur) var(--ease);
}
.fye .news__more:hover { background: var(--sage); color: var(--teal); }

.fye .news__ph { display: block; width: 100%; height: 100%; min-height: 160px; background: var(--ivory); border: var(--hairline); }
.fye .news__foot { display: flex; justify-content: center; margin-top: var(--s8); }

/* Live's caps: between these widths the columns stretch to whatever the three
   cards need, so the band runs long. Cap the imagery, clamp the text. */
@media (min-width: 901px) and (max-width: 1400px) {
  .fye .news__lead-img :where(img) { max-height: 560px; }
  .fye .news__row-img { flex: 0 0 190px; }
  .fye .news__title,
  .fye .news__excerpt {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
}

@media (max-width: 900px) {
  .fye .news__grid { grid-template-columns: 1fr; gap: var(--s7); }

  /* EVERY desktop mechanic has to stand down here, not just the caption's
     position. On desktop the right column sets the height, the lead image
     fills it with height: 100%, and the caption is absolute inside it. Stacked,
     there is no definite height to fill, so height: 100% resolves to auto in
     some places and collapses in others — which is how the caption ended up
     over the next article's photograph even with position: static.
     Spelled out property by property, because relying on one of them is what
     failed the first time. */
  .fye .news__lead { position: static; }
  .fye .news__lead-img { height: auto; }
  .fye .news__lead-img :where(img) { height: auto; }
  .fye .news__list { height: auto; }
  .fye .news__row { flex: 0 0 auto; }
  .fye .news__row-img :where(img) { height: auto; }

  .fye .news__lead-words,
  .fye .band--white .news__lead-words {
    position: static;
    max-width: 100%;
    padding: var(--s4) 0 0;
    background: transparent;
  }
  .fye .news__lead-img :where(img) { max-height: 420px; }
  .fye .news__row { flex-direction: column; gap: 10px; }
  .fye .news__row-img { flex: 0 0 auto; }
  .fye .news__row-img :where(img) { max-height: 220px; }
}

/* ---------------------------------------------------------------------------
   TOUCH TARGETS, 03/09/2026. Found by fyeSmoke on the live homepage.

   .news__more measured 118x31, .news__title about 22px on any title short
   enough to sit on one line. Both under the 44px minimum, conventions §7.

   flex + min-height, not padding: a title that already wraps to two lines is
   past 44px and is left completely unchanged, while a single-line title grows
   to 44px with the text centred, which reads as space above the excerpt.
   Padding would have shifted every title, wrapped or not.
   --------------------------------------------------------------------------- */
.fye .news__more {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
}
.fye .news__title a,
.fye a.news__title {
  display: flex;
  align-items: center;
  min-height: 44px;
}
{% endstylesheet %}

{% schema %}
{
  "name": "Latest news",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Latest news" },
    { "type": "blog", "id": "blog", "label": "Blog", "info": "Uses the 4 most recent posts: 1 featured + 3 compact." },
    { "type": "text", "id": "btn_label", "label": "Article button label", "default": "Read more" },
    { "type": "text", "id": "view_all_label", "label": "Closing button label", "default": "View more" },
    { "type": "header", "content": "Background" },
    {
      "type": "select", "id": "bg_color", "label": "Background", "default": "ivory",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Champagne ivory" },
        { "value": "mist",  "label": "Mist blue" }
      ]
    }
  ],
  "presets": [{ "name": "Latest news" }]
}
{% endschema %}
