{%- comment -%}
  main-404 — the not-found page. 1 use: 404.

  NEW FILE. Live's 404.json carries a bare `main-404` with no settings at all,
  so there was nothing to port — this is written to the v3 system.

  WHAT A 404 IS FOR, and why this one has a search field: someone here followed
  a dead link or mistyped a URL. The old site has ~120 pages and this rebuild
  has moved several of them, so the most useful thing on the page is a way to
  find what they meant, not an apology. Search field first, then the handful of
  places most people actually want.

  Deliberately NOT here: a product grid. A 404 is not a shopping surface, and
  filling it with rings makes the wrong thing the answer.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign band = s.band | default: 'ivory'
-%}

<section class="nf band band--{{ band }}" data-screen-label="404">
  <div class="wrap wrap--narrow nf__in">

    {%- if s.eyebrow != blank -%}
      <p class="eyebrow">{{ s.eyebrow }}</p>
    {%- endif -%}

    <h1 class="nf__h">{{ s.heading | default: 'We cannot find that page' }}</h1>

    {%- if s.body != blank -%}
      <div class="lead nf__body">{{ s.body }}</div>
    {%- endif -%}

    <form class="nf__form" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="nf-q">Search the site</label>
      <input id="nf-q" type="search" name="q"
             placeholder="{{ s.placeholder | default: 'Rings, stones, guides…' | escape }}"
             autocomplete="off">
      <button class="btn" type="submit">{{ s.button_label | default: 'Search' }}</button>
    </form>

    {%- if section.blocks.size > 0 -%}
      <div class="nf__links">
        {%- if s.links_heading != blank -%}
          <p class="nf__lh">{{ s.links_heading }}</p>
        {%- endif -%}
        <ul>
          {%- for block in section.blocks -%}
            {%- if block.settings.label != blank -%}
              <li {{ block.shopify_attributes }}>
                <a href="{{ block.settings.url | default: '/' }}">{{ block.settings.label }}</a>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}

  </div>
</section>

{% stylesheet %}
.fye .nf__in { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s5); }
.fye .nf__h { margin: 0; }
.fye .nf__body { margin: 0; max-width: 54ch; }
.fye .nf__body :where(p:last-child) { margin-bottom: 0; }

.fye .nf__form {
  display: flex;
  flex-wrap: wrap;
  gap: var(--s3);
  align-items: stretch;
  width: 100%;
  max-width: 560px;
  margin-top: var(--s3);
}
.fye .nf__form input[type="search"] { flex: 1 1 240px; min-width: 0; min-height: 48px; }
.fye .nf__form .btn { flex: 0 0 auto; }

.fye .nf__links { margin-top: var(--s5); }
.fye .nf__lh {
  margin: 0 0 var(--s3);
  font-size: var(--fs-eyebrow);
  font-weight: var(--fw-medium);
  letter-spacing: var(--tr-eyebrow);
  text-transform: uppercase;
  color: var(--ink-soft);
}
.fye .nf__links ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s2) var(--s6); }
.fye .nf__links li { margin: 0; }
/* 44px on a list of links someone taps in frustration. */
.fye .nf__links a {
  display: inline-flex;
  align-items: center;
  min-height: 44px;
  font-size: var(--fs-small);
  border-bottom: 1px solid currentColor;
}

@media (max-width: 560px) {
  .fye .nf__form { max-width: none; }
  .fye .nf__form .btn { width: 100%; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Page not found" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We cannot find that page" },
    {
      "type": "richtext", "id": "body", "label": "Text",
      "default": "<p>The link may be out of date, or the address slightly off. Search below, or start from one of these.</p>"
    },
    { "type": "header", "content": "Search" },
    { "type": "text", "id": "placeholder", "label": "Placeholder", "default": "Rings, stones, guides…" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Search" },
    { "type": "header", "content": "Links" },
    { "type": "text", "id": "links_heading", "label": "Links heading", "default": "Or go to" },
    { "type": "header", "content": "Background" },
    {
      "type": "select", "id": "band", "label": "Background", "default": "ivory",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Champagne ivory" },
        { "value": "mist",  "label": "Mist blue" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Link",
      "settings": [
        { "type": "text", "id": "label", "label": "Label" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    { "name": "404", "blocks": [{ "type": "link" }, { "type": "link" }, { "type": "link" }] }
  ]
}
{% endschema %}
