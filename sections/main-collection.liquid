      "type": "range",
      "id": "limit",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "unit": "pr",
      "default": 24
    },
    {
      "type": "select",
      "id": "col_dk",
      "label": "Columns",
      "default": "4",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ]
    },
    {
      "type": "select",
      "id": "col_mb",
      "label": "Columns on mobile",
      "default": "2",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ]
    },

    { "type": "header", "content": "Filter rail" },
    {
      "type": "paragraph",
      "content": "The filters come from the xCloud app embed. If the rail is empty, enable that embed in the App embeds panel — it is not part of this section. The app's own horizontal filter bar is hidden on purpose."
    },
    {
      "type": "checkbox",
      "id": "fye_rail_head",
      "label": "Show rail heading",
      "default": true
    },
    { "type": "text", "id": "fye_rail_title", "label": "Rail heading", "default": "Refine" },
    { "type": "text", "id": "fye_rail_clear", "label": "Clear link label", "default": "Clear all" },

    { "type": "header", "content": "Rail promo" },
    { "type": "text", "id": "fye_promo_heading", "label": "Heading" },
    { "type": "textarea", "id": "fye_promo_body", "label": "Body" },
    { "type": "text", "id": "fye_promo_label", "label": "Link label" },
    { "type": "url", "id": "fye_promo_link", "label": "Link" },

    { "type": "header", "content": "Bespoke tile" },
    {
      "type": "paragraph",
      "content": "Sits in the grid on page one only, and only when the collection has at least four products. Leave the heading empty to hide it."
    },
    { "type": "text", "id": "fye_tile_eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "fye_tile_heading", "label": "Heading" },
    { "type": "textarea", "id": "fye_tile_body", "label": "Body" },
    { "type": "text", "id": "fye_tile_label", "label": "Link label" },
    { "type": "url", "id": "fye_tile_link", "label": "Link" },
    {
      "type": "range",
      "id": "fye_tile_position",
      "label": "Grid position",
      "min": 1,
      "max": 12,
      "step": 1,
      "unit": "th",
      "default": 4
    },

    { "type": "header", "content": "Description" },
    {
      "type": "checkbox",
      "id": "show_desc",
      "label": "Show collection description",
      "default": false
    }
  ],
  "blocks": [
    { "type": "layout", "name": "Result count", "limit": 1 },
    { "type": "sortby", "name": "Sort", "limit": 1 },
    { "type": "filter", "name": "Filter rail", "limit": 1 }
  ]
}
