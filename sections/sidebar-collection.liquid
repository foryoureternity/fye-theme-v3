{%- comment -%}
  sidebar-collection — the sidebar beside a collection grid.

  Same shell as sidebar-page, same widget snippet; the difference is the block
  set. Collection navigation (`category`) and the facets slot (`filter`) live
  here; blog categories, tags and recent articles live in sidebar-page.

  Both files exist because both type names are frozen — JSON templates
  reference them, and a rename means re-entering content by hand.

  WHAT CHANGED FROM THE OLD THEME
  - Widget heading IDs stay as they were: collection blocks call it `heading`,
    page blocks call it `title`. The snippet reads `heading | default: title`,
    so both keep working. Do not "fix" the inconsistency — 33 templates carry
    the old keys.
  - `category` supports three levels as before, but each level with children now
    has a real <button aria-expanded> disclosure instead of an inline
    `onclick="readMore(3)"` calling a function defined in a separate asset.
    Behaviour comes from data-fye-toggle in fye-ui.js.
  - `filter` renders an empty slot. main-collection is not built yet
    (build-state job 3); when it is, it renders the facet form into
    [data-fye-facets]. The block keeps its place in the block order so nobody
    has to re-add it in the editor later.
  - Dropped settings and blocks, and why: see the comment in sidebar-page.liquid
    and the DELIBERATELY NOT PORTED note in snippets/sidebar-widgets.liquid.
  - The old file also hid the 5- and 6-column collection layout buttons
    whenever a sidebar was present, from inside the sidebar's own <style>. That
    belongs to main-collection and will be handled there, not from here.

  ORDER MATTERS: the sidebar must sit ABOVE main-collection in the template's
  section order. In `collection.gemstones` it does.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ground = s.ground | default: 'white'
  assign size = s.size | default: 'medium'
  assign label = s.trigger_label | default: 'Filter and browse'
  assign drawer_id = 'sbar-' | append: section.id
-%}

<section class="sbar-sec sbar-sec--{{ size }} band band--{{ ground }}" data-screen-label="Collection sidebar">
  {%- if section.blocks.size > 0 -%}
    <button type="button" class="sbar__trigger btn btn--outline btn--sm"
      data-fye-drawer-open="{{ drawer_id }}" aria-expanded="false" aria-controls="{{ drawer_id }}">
      {%- render 'icon', name: 'filter', class: 'icon--sm' -%}
      <span>{{ label }}</span>
    </button>

    <div class="sbar" id="{{ drawer_id }}" data-fye-drawer="{{ drawer_id }}">
      <div class="sbar__panel">
        <div class="sbar__head">
          <span class="eyebrow">{{ label }}</span>
          {%- comment -%} Literal until locales/en.default.json gains a key. {%- endcomment -%}
          <button type="button" class="sbar__close" data-fye-drawer-close aria-label="Close">
            {%- render 'icon', name: 'close', class: 'icon--sm' -%}
          </button>
        </div>
        <div class="sbar__body">
          {%- render 'sidebar-widgets', blocks: section.blocks, context: 'collection' -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sidebar collection",
  "class": "fye-sec fye-sec--sidebar",
  "settings": [
    {
      "type": "text", "id": "trigger_label", "label": "Mobile button label", "default": "Filter and browse",
      "info": "Shown on the button that opens the sidebar below 900px."
    },
    {
      "type": "select", "id": "size", "label": "Column width", "default": "medium",
      "options": [
        { "value": "small",  "label": "Small (260px)" },
        { "value": "medium", "label": "Medium (320px)" },
        { "value": "large",  "label": "Large (380px)" }
      ]
    },
    {
      "type": "select", "id": "ground", "label": "Background", "default": "white",
      "info": "Match the collection section beside it.",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Ivory" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Collections",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Product categories" },
        {
          "type": "select", "id": "cat_source", "label": "Source", "default": "2",
          "options": [
            { "value": "1", "label": "Every collection in the store" },
            { "value": "2", "label": "A menu" }
          ]
        },
        { "type": "link_list", "id": "cat_link_list", "label": "Menu", "info": "Up to three levels deep." },
        { "type": "checkbox", "id": "count", "label": "Show product counts", "default": true }
      ]
    },
    {
      "type": "filter",
      "name": "Filters",
      "limit": 1,
      "settings": [
        { "type": "paragraph", "content": "Reserves the place where the collection filters will render. Nothing appears here until main-collection is built." }
      ]
    },
    {
      "type": "collection",
      "name": "Featured products",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "range", "id": "limit_pr", "label": "Products to show", "default": 3, "min": 1, "max": 8, "step": 1, "unit": "prod" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text_html", "label": "Text" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "image_picker", "id": "image_sidebar", "label": "Image" },
        { "type": "url", "id": "b_link", "label": "Link" },
        {
          "type": "select", "id": "open_link", "label": "Open link in", "default": "_self",
          "options": [
            { "value": "_self",  "label": "Same tab" },
            { "value": "_blank", "label": "New tab" }
          ]
        }
      ]
    },
    {
      "type": "gallery",
      "name": "Image grid",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "image_picker", "id": "img1", "label": "Image 1" },
        { "type": "url", "id": "link1", "label": "Link 1" },
        { "type": "image_picker", "id": "img2", "label": "Image 2" },
        { "type": "url", "id": "link2", "label": "Link 2" },
        { "type": "image_picker", "id": "img3", "label": "Image 3" },
        { "type": "url", "id": "link3", "label": "Link 3" },
        { "type": "image_picker", "id": "img4", "label": "Image 4" },
        { "type": "url", "id": "link4", "label": "Link 4" },
        { "type": "image_picker", "id": "img5", "label": "Image 5" },
        { "type": "url", "id": "link5", "label": "Link 5" },
        { "type": "image_picker", "id": "img6", "label": "Image 6" },
        { "type": "url", "id": "link6", "label": "Link 6" },
        {
          "type": "select", "id": "open_link", "label": "Open links in", "default": "_self",
          "options": [
            { "value": "_self",  "label": "Same tab" },
            { "value": "_blank", "label": "New tab" }
          ]
        }
      ]
    },
    {
      "type": "shipping",
      "name": "Guarantees",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "The For Your Eternity guarantee" },
        { "type": "text", "id": "shipping_1", "label": "Row 1", "default": "shipping, Free UK delivery, Fully insured and tracked", "info": "icon, title, description — icons: shipping, warranty, resize, ethical, star, certificate, check." },
        { "type": "text", "id": "shipping_2", "label": "Row 2" },
        { "type": "text", "id": "shipping_3", "label": "Row 3" },
        { "type": "text", "id": "shipping_4", "label": "Row 4" },
        { "type": "text", "id": "shipping_5", "label": "Row 5" },
        { "type": "text", "id": "shipping_6", "label": "Row 6" }
      ]
    },
    {
      "type": "html",
      "name": "App embed",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "html", "id": "html_content", "label": "HTML", "info": "For an app's mount point only — e.g. the xCloud search container. Not for layout or styling." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sidebar collection",
      "blocks": [{ "type": "category" }, { "type": "filter" }]
    }
  ]
}
{% endschema %}
