{%- comment -%}
  sidebar-page — the sidebar beside page content.

  A thin shell. Every widget it shows comes from snippets/sidebar-widgets.liquid,
  which sidebar-collection renders too; this file exists because the type name
  `sidebar-page` is frozen (JSON templates reference it) and because its block
  set differs — blog categories, tags and recent articles live here, facets
  live in sidebar-collection.

  WHAT CHANGED FROM THE OLD THEME
  - The [t4splitlz] template-split trick is gone. The old section rendered its
    whole body into a <template> and let JS cut it into pieces on a marker
    string; markup was therefore invisible until JS ran. Now it is plain HTML.
  - ONE set of markup serves both layouts. Above 900px the sidebar is a sticky
    column; at 900px and below the SAME element becomes a slide-in drawer, by
    CSS alone. The old theme rendered the widgets twice.
  - Five settings dropped, deliberately: `space` (widget gap — rhythm belongs
    to the design system), `br_style`, `brcolor`, `sidebar_bdr`, `sidebar_pd`
    (a free colour picker and two radius controls, against `--radius: 0`), and
    `enable_drawer`. Shopify ignores settings left in a JSON template that the
    schema no longer declares, so nothing errors; those values simply stop
    being read.
  - `enable_drawer` defaulted to "drawer at every width", but every template
    sampled sets it false. There is now one behaviour — column on desktop,
    drawer on mobile — instead of a switch nobody used.
  - `size` is kept, with its three original values, because the column width is
    a real per-page decision.

  ORDER MATTERS: the sidebar must sit ABOVE the content section in the
  template's section order. It takes column one and everything after it takes
  column two (see .fye-sec--sidebar in fye-core.css). A template that puts the
  sidebar last renders it as a narrow column BELOW the content — that is the
  template's ordering, not a CSS fault. `page.diamonds` and `page.gemstones`
  both do this, and both have the section disabled.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign ground = s.ground | default: 'white'
  assign size = s.size | default: 'medium'
  assign label = s.trigger_label | default: 'Browse guides'
  assign drawer_id = 'sbar-' | append: section.id
-%}

<section class="sbar-sec sbar-sec--{{ size }} band band--{{ ground }}" data-screen-label="Page sidebar">
  {%- if section.blocks.size > 0 -%}
    <button type="button" class="sbar__trigger btn btn--outline btn--sm"
      data-fye-drawer-open="{{ drawer_id }}" aria-expanded="false" aria-controls="{{ drawer_id }}">
      {%- render 'icon', name: 'menu', class: 'icon--sm' -%}
      <span>{{ label }}</span>
    </button>

    <div class="sbar" id="{{ drawer_id }}" data-fye-drawer="{{ drawer_id }}">
      <div class="sbar__panel">
        <div class="sbar__head">
          <span class="eyebrow">{{ label }}</span>
          {%- comment -%} Literal until locales/en.default.json gains a key. {%- endcomment -%}
          <button type="button" class="sbar__close" data-fye-drawer-close aria-label="Close">
            {%- render 'icon', name: 'close', class: 'icon--sm' -%}
          </button>
        </div>
        <div class="sbar__body">
          {%- render 'sidebar-widgets', blocks: section.blocks, context: 'page' -%}
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Sidebar page",
  "class": "fye-sec fye-sec--sidebar",
  "settings": [
    {
      "type": "text", "id": "trigger_label", "label": "Mobile button label", "default": "Browse guides",
      "info": "Shown on the button that opens the sidebar below 900px."
    },
    {
      "type": "select", "id": "size", "label": "Column width", "default": "medium",
      "options": [
        { "value": "small",  "label": "Small (260px)" },
        { "value": "medium", "label": "Medium (320px)" },
        { "value": "large",  "label": "Large (380px)" }
      ]
    },
    {
      "type": "select", "id": "ground", "label": "Background", "default": "white",
      "info": "Match the content section beside it.",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "ivory", "label": "Ivory" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "blog_cate",
      "name": "Blog categories",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Blog categories" },
        { "type": "link_list", "id": "cat_link_list", "label": "Menu", "info": "Blog links only; other link types are skipped." },
        { "type": "checkbox", "id": "count", "label": "Show article counts", "default": true }
      ]
    },
    {
      "type": "tags",
      "name": "Blog tags",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Browse by topic" },
        { "type": "checkbox", "id": "count", "label": "Show article counts", "default": true }
      ]
    },
    {
      "type": "post",
      "name": "Recent articles",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "Recent articles" },
        { "type": "blog", "id": "blog", "label": "Blog" },
        { "type": "range", "id": "limit_post", "label": "Articles to show", "default": 3, "min": 1, "max": 8, "step": 1, "unit": "posts" },
        { "type": "checkbox", "id": "date", "label": "Show the date", "default": true }
      ]
    },
    {
      "type": "collection",
      "name": "Featured products",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "You may also like" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "range", "id": "limit_pr", "label": "Products to show", "default": 3, "min": 1, "max": 8, "step": 1, "unit": "prod" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "richtext", "id": "text_html", "label": "Text" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "image_picker", "id": "image_sidebar", "label": "Image" },
        { "type": "url", "id": "b_link", "label": "Link" },
        {
          "type": "select", "id": "open_link", "label": "Open link in", "default": "_self",
          "options": [
            { "value": "_self",  "label": "Same tab" },
            { "value": "_blank", "label": "New tab" }
          ]
        }
      ]
    },
    {
      "type": "gallery",
      "name": "Image grid",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "image_picker", "id": "img1", "label": "Image 1" },
        { "type": "url", "id": "link1", "label": "Link 1" },
        { "type": "image_picker", "id": "img2", "label": "Image 2" },
        { "type": "url", "id": "link2", "label": "Link 2" },
        { "type": "image_picker", "id": "img3", "label": "Image 3" },
        { "type": "url", "id": "link3", "label": "Link 3" },
        { "type": "image_picker", "id": "img4", "label": "Image 4" },
        { "type": "url", "id": "link4", "label": "Link 4" },
        { "type": "image_picker", "id": "img5", "label": "Image 5" },
        { "type": "url", "id": "link5", "label": "Link 5" },
        { "type": "image_picker", "id": "img6", "label": "Image 6" },
        { "type": "url", "id": "link6", "label": "Link 6" },
        {
          "type": "select", "id": "open_link", "label": "Open links in", "default": "_self",
          "options": [
            { "value": "_self",  "label": "Same tab" },
            { "value": "_blank", "label": "New tab" }
          ]
        }
      ]
    },
    {
      "type": "shipping",
      "name": "Guarantees",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "title", "label": "Heading", "default": "The For Your Eternity guarantee" },
        { "type": "text", "id": "shipping_1", "label": "Row 1", "default": "shipping, Free UK delivery, Fully insured and tracked", "info": "icon, title, description — icons: shipping, warranty, resize, ethical, star, certificate, check." },
        { "type": "text", "id": "shipping_2", "label": "Row 2" },
        { "type": "text", "id": "shipping_3", "label": "Row 3" },
        { "type": "text", "id": "shipping_4", "label": "Row 4" },
        { "type": "text", "id": "shipping_5", "label": "Row 5" },
        { "type": "text", "id": "shipping_6", "label": "Row 6" }
      ]
    },
    {
      "type": "html",
      "name": "App embed",
      "settings": [
        { "type": "text", "id": "title", "label": "Heading" },
        { "type": "html", "id": "custom_html", "label": "HTML", "info": "For an app's mount point only — not for layout or styling." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Sidebar page",
      "blocks": [{ "type": "blog_cate" }]
    }
  ]
}
{% endschema %}
