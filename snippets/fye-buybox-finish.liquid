{%- assign finishes = finish_rows | split: ';' -%}

<div class="pdp__finish" data-fye-finish>

  <div class="pdp__finishhead">
    <p class="pdp__label">
      {{ s.finish_label | default: 'Custom finish' }}
      <span class="pdp__labelval" data-fye-finish-hint>{{ s.finish_hint | default: 'Polished as standard' }}</span>
    </p>

    <div class="pdp__seg" role="radiogroup" aria-label="{{ s.finish_label | default: 'Custom finish' | escape }}">
      <button type="button" role="radio" class="is-on" aria-checked="true" data-fye-finish-set="no">No</button>
      <button type="button" role="radio" aria-checked="false" data-fye-finish-set="yes">Yes</button>
    </div>
  </div>

  {%- comment -%}
    The chosen finish. Hidden until the toggle is on; it then shows Polished,
    so the shopper can see that "yes" has not silently changed anything yet.
  {%- endcomment -%}
  <div class="pdp__finishpick" data-fye-finish-pick hidden>
    <img class="pdp__finishthumb"
         src="{{ p.featured_image | image_url: width: 176 }}"
         alt=""
         width="88"
         height="88"
         loading="lazy"
         data-fye-finish-thumb>
    <span class="pdp__finishtxt">
      <span class="pdp__finishname" data-fye-finish-name>Polished</span>
      <span class="pdp__finishmeta" data-fye-finish-meta>Standard finish</span>
    </span>
    <span class="pdp__finishacts">
      <button type="button" class="pdp__finishreset" data-fye-finish-reset hidden>Back to polished</button>
      <button type="button" class="btn btn--outline pdp__finishopen" data-fye-finish-open>
        {{ s.finish_change_label | default: 'Change' }}
      </button>
    </span>
  </div>

  {%- comment -%}
    Always enabled, always sent — see the header. Its value is rewritten by
    fye-finish.js as the choice changes.
  {%- endcomment -%}
  <input type="hidden" name="properties[Finish]" value="Polished" data-fye-finish-prop>

  {%- comment -%}
    ---- The picker modal ----
    Same shell as the diamond picker (`.pdp__modal` / scrim / panel), one set
    of markup at every width: the grid reflows and becomes a sheet on a phone.
    Never a second copy of the content.

    Tiles are rendered by Liquid rather than fetched, because the list is
    fixed, small and the same on every plain ring. No request, no loading
    state, and the grid is in the DOM for search engines and for anyone with
    JS off, who still sees the finishes even though they cannot select one.
  {%- endcomment -%}
  <div class="pdp__modal" data-fye-finish-modal hidden>
    <div class="pdp__modalscrim" data-fye-finish-close></div>

    <div class="pdp__modalpanel" role="dialog" aria-modal="true" aria-labelledby="pdp-finish-title" tabindex="-1" data-fye-finish-panel>
      <div class="pdp__modalhead">
        <div>
          <h2 class="pdp__modaltitle" id="pdp-finish-title">{{ s.finish_heading | default: 'Choose your finish' }}</h2>
          <p class="pdp__modalsub">
            {{ s.finish_note | default: 'Every ring is polished as standard. Hand engraved patterns are cut into the outside of the band by our finishers, which is different from a custom engraved message inside the ring.' }}
          </p>
        </div>

        <button type="button" class="pdp__modalx" data-fye-finish-close aria-label="Close">
          {%- render 'icon', name: 'close' -%}
        </button>
      </div>

      <div class="pdp__modaltools">
        <label class="visually-hidden" for="pdp-finish-search">Search finishes</label>
        <input class="pdp__input pdp__finishsearch"
               type="search"
               id="pdp-finish-search"
               placeholder="{{ s.finish_search_label | default: 'Search finishes' | escape }}"
               autocomplete="off"
               data-fye-finish-search>
        <p class="pdp__count" data-fye-finish-count aria-live="polite">48 finishes</p>
      </div>

      <div class="pdp__finishgrid" role="radiogroup" aria-label="{{ s.finish_heading | default: 'Choose your finish' | escape }}" data-fye-finish-grid>

        {%- comment -%}
          Polished first, and marked as the default in words — it is the one
          tile that is not an HM photograph but this ring's own image.
        {%- endcomment -%}
        <button type="button"
                class="pdp__ftile is-on"
                role="radio"
                aria-checked="true"
                data-fye-ftile
                data-name="Polished"
                data-prop="Polished"
                data-hm=""
                data-search="polished default standard">
          <span class="pdp__ftileimg">
            <img src="{{ p.featured_image | image_url: width: 224 }}"
                 alt="{{ p.title | escape }}, polished"
                 width="112"
                 height="112"
                 loading="lazy">
          </span>
          <span class="pdp__ftilename">Polished</span>
          <span class="pdp__ftilehm">Standard finish</span>
          <span class="pdp__ftilemark" aria-hidden="true">{%- render 'icon', name: 'check' -%}</span>
        </button>

        {%- for row in finishes -%}
          {%- liquid
            assign bits = row | strip | split: '|'
            assign hm = bits[0] | strip
            assign name = bits[1] | strip
            assign slug = bits[2] | strip
          -%}
          {%- if slug == blank -%}{%- continue -%}{%- endif -%}
          {%- assign asset_name = 'rf-finish-' | append: slug | append: tone | append: '.jpg' -%}

          <button type="button"
                  class="pdp__ftile"
                  role="radio"
                  aria-checked="false"
                  data-fye-ftile
                  data-name="{{ name | escape }}"
                  data-prop="{{ name | append: ' (HM ' | append: hm | append: ')' | escape }}"
                  data-hm="HM {{ hm }}"
                  data-search="{{ name | downcase | escape }} hm{{ hm }} {{ hm }}">
            <span class="pdp__ftileimg">
              <img src="{{ asset_name | file_url }}"
                   alt="{{ name | escape }} finish on a {{ metal_now | escape }} band"
                   width="112"
                   height="112"
                   loading="lazy">
            </span>
            <span class="pdp__ftilename">{{ name }}</span>
            <span class="pdp__ftilehm">HM {{ hm }}</span>
            <span class="pdp__ftilemark" aria-hidden="true">{%- render 'icon', name: 'check' -%}</span>
          </button>
        {%- endfor -%}
      </div>

      {%- comment -%}
        Tapping a tile SELECTS; Confirm applies. Ed, 18/09/2026 — with 48
        near-identical photographs the shopper needs to put two side by side
        and change their mind, and an apply-on-tap grid closes under them the
        moment they touch the wrong one. Closing without confirming keeps the
        previous choice.
      {%- endcomment -%}
      <div class="pdp__modalfoot pdp__finishfoot">
        <span class="pdp__finishdraft">
          <img class="pdp__finishthumb pdp__finishthumb--sm"
               src="{{ p.featured_image | image_url: width: 88 }}"
               alt=""
               width="44"
               height="44"
               loading="lazy"
               data-fye-finish-draftimg>
          <span class="pdp__finishtxt">
            <span class="pdp__finishname" data-fye-finish-draftname>Polished</span>
            <span class="pdp__finishmeta" data-fye-finish-draftmeta>The standard finish, no extra work</span>
          </span>
        </span>
        <span class="pdp__finishbtns">
          <button type="button" class="btn btn--outline" data-fye-finish-cancel>Cancel</button>
          <button type="button" class="btn" data-fye-finish-confirm>{{ s.finish_confirm_label | default: 'Confirm finish' }}</button>
        </span>
      </div>
    </div>
  </div>
</div>

{%- comment -%}
  Loaded here rather than from the layout, so the ~3KB is requested only on
  the pages that render a picker. `defer` because nothing above depends on it
  and the markup is already usable without it.
{%- endcomment -%}
<script src="{{ 'fye-finish.js' | asset_url }}" defer></script>
