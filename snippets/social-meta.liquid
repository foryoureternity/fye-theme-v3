{%- comment -%}
  social-meta, Open Graph and Twitter card tags for every page.

  Added 03/09/2026 (audit 02/09/2026, D2). The layout emitted no og: or
  twitter: tags at all, so a ring shared on WhatsApp or iMessage got
  Shopify's fallback image with a scraped title and no description.

  RENDERED FROM layout/theme.liquid, in <head>, BEFORE content_for_header , 
  a scraper takes the first og:image it meets, and Shopify's own fallback
  tag arrives with content_for_header.

  `page_image` is Shopify's global: the product's featured image on a
  product page, the article's image on a post, the collection's image where
  one exists (none do yet, audit C3), and otherwise the social sharing
  image from Theme settings. `page_title` and `page_description` are the
  SEO title and description already resolved for the page, so the card says
  what the search result says. The price tags are the Open Graph product
  vocabulary that WhatsApp and Pinterest read.
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
{%- if page_image -%}
  {%- assign og_img = page_image | image_url: width: 1200 -%}
<meta property="og:image" content="https:{{ og_img }}">
<meta property="og:image:secure_url" content="https:{{ og_img }}">
  {%- if page_image.width -%}
<meta property="og:image:width" content="{{ page_image.width | at_most: 1200 }}">
    {%- if page_image.width > 1200 -%}
      {%- assign og_h = page_image.height | times: 1200 | divided_by: page_image.width -%}
<meta property="og:image:height" content="{{ og_h }}">
    {%- else -%}
<meta property="og:image:height" content="{{ page_image.height }}">
    {%- endif -%}
  {%- endif -%}
  {%- if page_image.alt != blank -%}
<meta property="og:image:alt" content="{{ page_image.alt | escape }}">
  {%- endif -%}
{%- endif -%}
{%- if request.page_type == 'product' and product != blank -%}
<meta property="product:price:amount" content="{{ product.price_min | divided_by: 100.0 }}">
<meta property="product:price:currency" content="{{ shop.currency }}">
{%- endif -%}
{%- if request.page_type == 'article' and article != blank -%}
<meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  {%- if article.author != blank -%}
<meta property="article:author" content="{{ article.author | escape }}">
  {%- endif -%}
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
