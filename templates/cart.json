        "intro": {
          "type": "2",
          "settings": {
            "content": "<p>Please do contact us before purchasing if you have any questions, or need a customisation to your ring or diamonds. Once you order we will be in touch to check your delivery instructions and give you an estimated delivery date.</p>"
          }
        }
      },
      "block_order": ["title", "intro"],
      "settings": {}
    },
