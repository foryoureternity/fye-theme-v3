{%- comment -%}
  collection.fye-finder — fragment template, NOT a customer-facing page.

  The ring finder fetches this to show matching rings inline, without sending
  the shopper to the collection page first (Ed, 03/09/2026). It is a real
  collection request, so Shopify's native filters apply exactly as they do on
  /collections/<handle>:

    /collections/plain-wedding-rings?filter.p.m.filters.profile=Concave&view=fye-finder

  `{% layout none %}` means no header, footer, scripts or app embeds — the
  response is a couple of KB of markup and nothing else. Styling lives in
  sections/fye-ring-finder.liquid, which owns the .rfd-card classes.

  Do not add this to a menu, and do not link to it: with no layout it renders
  as an unstyled orphan. With no layout it emits no head, so it cannot
  carry a noindex tag; keeping it unlinked is what keeps it out of the index.
{%- endcomment -%}
{%- layout none -%}
{%- paginate collection.products by 12 -%}
<div data-count="{{ paginate.items }}" data-shown="{{ collection.products.size }}">
  {%- for product in collection.products -%}
    {%- assign attrs = '' -%}
    {%- comment -%}
      One data attribute per metal this product holds a shot for, so the
      finder can show the chosen metal without another request. The
      template cannot read the answer (no query params in Liquid), so it
      offers what it has and lets the JS choose.

      Matched on ALT TEXT ("...in Yellow Gold"), which is what a human
      wrote and what gets corrected when wrong; the YG-/RG-/WG- filename
      prefix is the fallback for shots whose alt was never written.
    {%- endcomment -%}
    {%- assign shots = '' -%}
    {%- for img in product.images -%}
      {%- assign a = img.alt | default: '' | downcase -%}
      {%- assign fn = img.src | split: '?' | first | split: '/' | last | downcase -%}
      {%- assign hit = '' -%}
      {%- if a contains 'yellow gold' or fn contains 'yg-' -%}
        {%- assign hit = 'yellow-gold' -%}
      {%- elsif a contains 'rose gold' or fn contains 'rg-' -%}
        {%- assign hit = 'rose-gold' -%}
      {%- elsif a contains 'white gold' or fn contains 'wg-' -%}
        {%- assign hit = 'white-gold' -%}
      {%- elsif a contains 'palladium' -%}
        {%- assign hit = 'palladium' -%}
      {%- elsif a contains 'platinum' -%}
        {%- assign hit = 'platinum' -%}
      {%- endif -%}
      {%- comment -%} First shot of a metal wins; later duplicates are ignored. {%- endcomment -%}
      {%- if hit != '' -%}
        {%- unless shots contains hit -%}
          {%- assign shots = shots | append: hit | append: ' ' -%}
          {%- capture attrs -%}{{ attrs }} data-img-{{ hit }}="{{ img | image_url: width: 480 }}"{%- endcapture -%}
        {%- endunless -%}
      {%- endif -%}
    {%- endfor -%}
    <a class="rfd-card" href="{{ product.url }}"{{ attrs }}>
      <span class="rfd-card__media">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 480 }}"
               alt="{{ product.featured_image.alt | escape }}"
               width="240" height="240" loading="lazy">
        {%- endif -%}
      </span>
      <span class="rfd-card__title">{{ product.title }}</span>
      <span class="rfd-card__price">{{ product.price_min | money }}</span>
    </a>
  {%- endfor -%}
</div>
{%- endpaginate -%}
