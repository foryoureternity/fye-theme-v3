        "text_block_P8TPry": {
          "type": "text_block",
          "settings": {
            "col_dk": "8",
            "title": "",
            "text": "<p>For Your Eternity is an independent London jeweller founded by Edward Marno in 2024 and a member of the National Association of Jewellers. We make engagement, wedding and eternity rings and diamond bracelets: more than 3,000 rings to configure online in platinum or gold, set with GIA or IGI certified natural or lab-grown diamonds, or coloured gemstones from sapphire and ruby to tanzanite and opal.</p><p>Every piece is made in our London workshop, ethically sourced, transparently priced with the price fixed before we make, and hallmarked. Consultations are free, by appointment, in person across London or by video, phone or WhatsApp.</p>",
            "enable_image": false,
            "button_label": "",
            "button_link": "",
            "open_link": "_self"
          }
        }
      },
