    "fye_testimonials_WTRaAj": {
      "type": "fye-testimonials",
      "blocks": {
        "testimonial_YWNeHc": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>The entire process was informative, with helpful guidence, lots of ideas and resulting in delivery of the very moment I had hoped. For your eternity is the place to start your special moments without doubt. Incredible quality and the correct asnwer !</p>",
            "name": "Matthew C.",
            "context": "Engagement ring",
            "rating": 5,
            "source": "Trustpilot"
          }
        },
        "testimonial_3QkATh": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Expert and friendly guidance through out the process. I ended up with a beautiful ring both me and my partner love. would recommend highly to anyone.</p>",
            "name": "James G.",
            "context": "Engagement ring",
            "rating": 5,
            "source": "Trustpilot"
          }
        },
        "testimonial_Rhnrrc": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Trustworthy, reliable and attentive - exactly what we wanted and delivered in time for the big day - thank you Ed. Great service</p>",
            "name": "Azeem A.",
            "context": "Pair of wedding rings",
            "rating": 5,
            "source": "Trustpilot"
          }
        },
        "testimonial_tpRicky": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>What a amazing experience, full 5 star concierge treatment from start to finish</p>",
            "name": "Ricky",
            "context": "",
            "rating": 5,
            "source": "Trustpilot"
          }
        },
        "testimonial_tpLydia": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Ed really knows his stuff! Myself and my husband bought our wedding rings through ‘For your eternity’ and we are so happy with them! The whole process was enjoyable and seamless! Buying your wedding rings is a big decision and Ed was so knowledgeable and patient!</p>",
            "name": "Lydia",
            "context": "Pair of wedding rings",
            "rating": 5,
            "source": "Trustpilot"
          }
        },
        "testimonial_tpTom": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>My wife and I had a brilliant experience with For Your Eternity while choosing her wedding ring. Ed was absolutely fantastic - friendly, knowledgeable, and genuinely invested in helping us find the perfect ring.</p>",
            "name": "Tom",
            "context": "Wedding ring",
            "rating": 5,
            "source": "Trustpilot"
          }
        },
        "testimonial_tpSamir": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Had a tricky problem with my engagement ring. Felt uninformed and uncertain how to proceed. Ed helped me through every step of our process and came up with a great solution. Thoroughly recommend for your jewellery needs.</p>",
            "name": "Samir K.",
            "context": "Engagement ring resizing",
            "rating": 5,
            "source": "Trustpilot"
          }
        },
        "testimonial_tpPedro": {
          "type": "testimonial",
          "settings": {
            "quote": "<p>Great experience and product, Ed understands the importance of the moment and offers you a variety of options, no matter if you have an idea of what you want or you ar just browsing.</p>",
            "name": "Pedro S.",
            "context": "Engagement ring",
            "rating": 5,
            "source": "Trustpilot"
          }
        }
