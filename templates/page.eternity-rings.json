    "intro_eter": {
      "type": "fye-rich-text",
      "settings": {
        "band": "ivory",
        "narrow": true,
        "heading": "What is an eternity ring?",
        "body": "<p>An eternity ring is a band set with a continuous line of matching stones, a symbol of lasting love, traditionally given on a significant anniversary or the birth of a child. A full eternity ring is set all the way round; a half eternity across the top only. After that you choose the setting, the stone and the total carat weight, which is the sum of every stone, not the size of one.</p><p>Our <a href=\"/pages/eternity-ring-guide\">Eternity Ring Guide</a> goes through each choice, or <a href=\"/pages/contact-us#popup-contact\">book a free consultation</a>.</p>",
        "variant": "default",
        "eyebrow": "Start here"
      }
